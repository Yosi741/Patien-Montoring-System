<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1150.0"
        prefHeight="720.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.PatientListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label text="Patients"
                       style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="SQLite patient board with controlled JavaFX write preview"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Sync From Legacy Storage" onAction="#syncFromLegacyStorage"
                    style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button text="Back to Dashboard" onAction="#backToDashboard"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox spacing="12.0">
                <Button text="All Patients" onAction="#showAllPatients"
                        style="-fx-background-color: white; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 16; -fx-padding: 12 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 4); -fx-cursor: hand;" />
                <Button text="Active Patients" onAction="#showActivePatients"
                        style="-fx-background-color: white; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 16; -fx-padding: 12 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 4); -fx-cursor: hand;" />
                <Button text="Critical/Emergency" onAction="#showCriticalEmergency"
                        style="-fx-background-color: #FFEBEE; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-background-radius: 16; -fx-padding: 12 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 4); -fx-cursor: hand;" />
                <Button text="High Priority" onAction="#showHighPriority"
                        style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-background-radius: 16; -fx-padding: 12 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 4); -fx-cursor: hand;" />
                <Button text="Recently Updated" onAction="#showRecentlyUpdated"
                        style="-fx-background-color: white; -fx-text-fill: #6A1B9A; -fx-font-weight: bold; -fx-background-radius: 16; -fx-padding: 12 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 4); -fx-cursor: hand;" />
            </HBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Search" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <TextField fx:id="searchField" promptText="Patient ID or name" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC; -fx-padding: 10 12; -fx-font-size: 14px;" />

                    <Label text="Section" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <ComboBox fx:id="sectionFilter" prefWidth="150.0"
                              style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                    <Label text="Room" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <ComboBox fx:id="roomFilter" prefWidth="120.0"
                              style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Status" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <ComboBox fx:id="statusFilter" prefWidth="140.0"
                              style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                    <Label text="Priority" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <ComboBox fx:id="priorityFilter" prefWidth="150.0"
                              style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                    <Button text="Clear Filters" onAction="#clearFilters"
                            style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                    <Button text="Refresh" onAction="#loadPatients"
                            style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="addPatientButton" text="Add Patient" onAction="#addPatient"
                            style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                    <Button fx:id="editSelectedPatientButton" text="Edit Selected" onAction="#editSelectedPatient"
                            style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                    <Button fx:id="dischargePatientButton" text="Discharge" onAction="#dischargeSelectedPatient"
                            style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                    <Button text="View Details" onAction="#viewDetails"
                            style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                </HBox>

                <FlowPane fx:id="filterChipsBox" hgap="8.0" vgap="8.0" />
            </VBox>

            <VBox spacing="10.0"
                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);"
                  VBox.vgrow="ALWAYS">

                <Label text="Patient Board"
                       style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />

                <TableView fx:id="patientTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #E0E7EF; -fx-border-radius: 14; -fx-background-radius: 14;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="Patient ID" prefWidth="120.0" />
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="190.0" />
                        <TableColumn fx:id="birthDateColumn" text="Birth Date" prefWidth="110.0" />
                        <TableColumn fx:id="genderColumn" text="Gender" prefWidth="90.0" />
                        <TableColumn fx:id="sectionColumn" text="Section" prefWidth="150.0" />
                        <TableColumn fx:id="roomColumn" text="Room" prefWidth="90.0" />
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120.0" />
                        <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="120.0" />
                    </columns>
                </TableView>
            </VBox>

            <Label fx:id="statusLabel" text="Patients loaded from SQLite: 0"
                   style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
        </VBox>
    </center>
</BorderPane>