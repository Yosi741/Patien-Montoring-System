<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1150.0"
        prefHeight="720.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.PatientListController" styleClass="content-page">

    <center>
        <ScrollPane fitToWidth="true" styleClass="patient-board-scroll">
        <VBox spacing="18.0" styleClass="patient-board-page">
            <padding>
                <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="patient-hero">
                <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                    <Label text="Patient Board" styleClass="patient-page-title" />
                    <Label text="Find patients, review status, and start common clinical actions from one patient board." styleClass="patient-page-subtitle" wrapText="true" />
                    <Label fx:id="statusLabel" text="Patients loaded: 0" styleClass="patient-status-line" />
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="patient-header-actions">
                    <Button text="Import Existing Data" onAction="#syncFromLegacyStorage" styleClass="patient-action-secondary" />
                    <Button text="Back to Dashboard" onAction="#backToDashboard" styleClass="patient-action-ghost" />
                </HBox>
            </HBox>

            <FlowPane hgap="10.0" vgap="10.0" styleClass="patient-quick-filter-row">
                <Button text="All Patients" onAction="#showAllPatients" styleClass="patient-filter-chip-button" />
                <Button text="Active Patients" onAction="#showActivePatients" styleClass="patient-filter-chip-button" />
                <Button fx:id="deceasedQuickButton" text="Deceased Patients" onAction="#showDeceasedPatients" styleClass="patient-filter-chip-danger" />
                <Button fx:id="newbornQuickButton" text="Newborns" onAction="#showNewborns" styleClass="patient-filter-chip-button" />
                <Button text="Critical / Emergency" onAction="#showCriticalEmergency" styleClass="patient-filter-chip-danger" />
                <Button text="High Priority" onAction="#showHighPriority" styleClass="patient-filter-chip-warning" />
                <Button text="Recently Updated" onAction="#showRecentlyUpdated" styleClass="patient-filter-chip-button" />
            </FlowPane>

            <VBox spacing="16.0" styleClass="patient-filter-card">
                <GridPane hgap="14.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="36.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="16.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="16.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="16.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="16.0" />
                    </columnConstraints>

                    <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Search" styleClass="field-label" />
                        <TextField fx:id="searchField" promptText="Patient ID or name" styleClass="patient-input" />
                    </VBox>

                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Section" styleClass="field-label" />
                        <ComboBox fx:id="sectionFilter" maxWidth="Infinity" styleClass="patient-input" />
                    </VBox>

                    <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Room" styleClass="field-label" />
                        <ComboBox fx:id="roomFilter" maxWidth="Infinity" styleClass="patient-input" />
                    </VBox>

                    <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="Status" styleClass="field-label" />
                        <ComboBox fx:id="statusFilter" maxWidth="Infinity" styleClass="patient-input" />
                    </VBox>

                    <VBox spacing="6.0" GridPane.columnIndex="4" GridPane.rowIndex="0">
                        <Label text="Priority" styleClass="field-label" />
                        <ComboBox fx:id="priorityFilter" maxWidth="Infinity" styleClass="patient-input" />
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="patient-action-row">
                    <Button text="Clear Filters" onAction="#clearFilters" styleClass="patient-action-ghost" />
                    <Button text="Refresh" onAction="#loadPatients" styleClass="patient-action-ghost" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="addPatientButton" text="Add Patient" onAction="#addPatient" styleClass="patient-action-primary" />

                    <Button fx:id="editSelectedPatientButton" text="Edit Patient" onAction="#editSelectedPatient" styleClass="patient-action-secondary" />

                    <Button fx:id="enterVitalsButton" text="Enter Vitals" onAction="#enterVitalsForSelectedPatient" styleClass="patient-action-secondary" />

                    <Button fx:id="viewPatientFileButton" text="View Patient File" onAction="#viewDetails" styleClass="patient-action-primary" />

                    <Button fx:id="viewDeathRecordButton" text="View Death Record" onAction="#viewDeathRecord" managed="false" visible="false" styleClass="patient-action-secondary" />

                    <Button fx:id="dischargePatientButton" text="Discharge / Deactivate" onAction="#dischargeSelectedPatient" styleClass="patient-action-danger" />
                </HBox>

                <FlowPane fx:id="filterChipsBox" hgap="8.0" vgap="8.0" />
            </VBox>

            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS" styleClass="patient-table-card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="boardTitleLabel" text="Patients" styleClass="patient-section-title" />
                        <Label fx:id="boardSubtitleLabel" text="Double-click a row to open the full patient file." styleClass="patient-page-subtitle" />
                    </VBox>
                </HBox>

                <TableView fx:id="patientTable" prefHeight="420.0" VBox.vgrow="ALWAYS" styleClass="patient-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="Patient ID" prefWidth="130.0" />
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="210.0" />
                        <TableColumn fx:id="birthDateColumn" text="Birth Date" prefWidth="120.0" />
                        <TableColumn fx:id="genderColumn" text="Gender" prefWidth="100.0" />
                        <TableColumn fx:id="sectionColumn" text="Section" prefWidth="150.0" />
                        <TableColumn fx:id="roomColumn" text="Room" prefWidth="105.0" />
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="130.0" />
                        <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="130.0" />
                        <TableColumn fx:id="deathTimeColumn" text="Death Time" prefWidth="170.0" visible="false" />
                        <TableColumn fx:id="pronouncedByColumn" text="Pronounced By" prefWidth="150.0" visible="false" />
                        <TableColumn fx:id="deathCertificateColumn" text="Certificate" prefWidth="135.0" visible="false" />
                    </columns>
                </TableView>

                <TableView fx:id="newbornTable" prefHeight="420.0" VBox.vgrow="ALWAYS" managed="false" visible="false" styleClass="patient-table">
                    <columns>
                        <TableColumn fx:id="newbornIdColumn" text="Newborn ID" prefWidth="130.0" />
                        <TableColumn fx:id="babyNameColumn" text="Baby Name" prefWidth="170.0" />
                        <TableColumn fx:id="newbornGenderColumn" text="Gender" prefWidth="95.0" />
                        <TableColumn fx:id="birthTimeColumn" text="Birth Time" prefWidth="160.0" />
                        <TableColumn fx:id="motherColumn" text="Mother" prefWidth="220.0" />
                        <TableColumn fx:id="newbornSectionColumn" text="Section" prefWidth="125.0" />
                        <TableColumn fx:id="newbornRoomColumn" text="Room" prefWidth="100.0" />
                        <TableColumn fx:id="certificateStatusColumn" text="Certificate" prefWidth="135.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
