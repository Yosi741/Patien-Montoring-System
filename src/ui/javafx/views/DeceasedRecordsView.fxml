<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.DeceasedRecordsController">

    

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="screen-title" text="Deceased Records" />
                            <Label styleClass="muted-text" text="Death records, certificate status, and safe local certificate controls" wrapText="true" />
                        </VBox>
                        <Button onAction="#backToDashboard" styleClass="secondary-button" text="Back to Dashboard" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card" />

                    <VBox fx:id="accessDeniedPane" managed="false" spacing="10.0" styleClass="warning-panel" visible="false">
                        <Label styleClass="warning-value" text="Access denied" />
                        <Label styleClass="body-text" text="Deceased records are available to Admin, Doctor, and Nurse roles." wrapText="true" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">
                        <HBox spacing="14.0">
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Total Records" />
                                <Label fx:id="totalRecordsLabel" styleClass="screen-title" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Certificates Generated" />
                                <Label fx:id="certificatesGeneratedLabel" styleClass="success-value" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Pending Certificates" />
                                <Label fx:id="pendingCertificatesLabel" styleClass="warning-value" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Deaths This Month" />
                                <Label fx:id="deathsThisMonthLabel" styleClass="body-text" text="0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label styleClass="field-label" text="Search" />
                                <TextField fx:id="searchField" promptText="Patient ID or name" styleClass="control-input" HBox.hgrow="ALWAYS" />
                                <Label styleClass="field-label" text="Date" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="150.0" styleClass="control-input" />
                                <Label styleClass="field-label" text="Section" />
                                <ComboBox fx:id="sectionFilter" prefWidth="170.0" styleClass="control-input" />
                            </HBox>

                            <FlowPane alignment="CENTER_RIGHT" hgap="10.0" vgap="10.0">
                                <Button onAction="#openPatientDetail" styleClass="secondary-button" text="Open Patient Detail" />
                                <Button fx:id="updateRecordButton" onAction="#updateRecord" styleClass="secondary-button" text="Update Record" />
                                <Button fx:id="generateCertificateButton" onAction="#generateCertificate" styleClass="primary-button" text="Generate Certificate" />
                                <Button fx:id="openCertificateButton" onAction="#openCertificate" styleClass="secondary-button" text="Open Certificate" />
                                <Button fx:id="sendNoticeButton" onAction="#sendCertificateNotice" styleClass="secondary-button" text="Send Certificate Notice" />
                                <Button fx:id="copySummaryButton" onAction="#copySummary" styleClass="secondary-button" text="Copy Summary" />
                                <Button onAction="#clearFilters" styleClass="secondary-button" text="Clear Filters" />
                                <Button onAction="#loadRecords" styleClass="secondary-button" text="Refresh" />
                            </FlowPane>
                        </VBox>

                        <HBox spacing="18.0">
                            <VBox spacing="10.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="section-title" text="Records" />
                                                                <TableView fx:id="deceasedTable" prefHeight="500.0" styleClass="dialog-card clinical-table">
                                    <columns>
                                        <TableColumn fx:id="rowNumberColumn" prefWidth="55.0" sortable="false" text="#" />
                                        <TableColumn fx:id="patientIdColumn" prefWidth="110.0" text="Patient ID" />
                                        <TableColumn fx:id="patientNameColumn" prefWidth="180.0" text="Patient Name" />
                                        <TableColumn fx:id="deathTimeColumn" prefWidth="170.0" text="Death Time" />
                                        <TableColumn fx:id="pronouncedByColumn" prefWidth="140.0" text="Pronounced By" />
                                        <TableColumn fx:id="causeColumn" prefWidth="220.0" text="Cause" />
                                        <TableColumn fx:id="certificateColumn" prefWidth="130.0" text="Certificate" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox prefWidth="360.0" spacing="12.0" styleClass="panel-card">
                                <Label styleClass="section-title" text="Record Detail" />
                                <Label styleClass="metric-label" text="Patient" />
                                <Label fx:id="detailPatientLabel" text="No record selected" wrapText="true" />
                                <Label styleClass="metric-label" text="Death Time" />
                                <Label fx:id="detailDeathTimeLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Pronounced By" />
                                <Label fx:id="detailPronouncedByLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Cause" />
                                <Label fx:id="detailCauseLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Notes" />
                                <Label fx:id="detailNotesLabel" text="Select a deceased record to view details." wrapText="true" />
                                <Label styleClass="metric-label" text="Certificate Path" />
                                <Label fx:id="detailCertificateLabel" text="-" wrapText="true" />
                            </VBox>
                        </HBox>

                        <Label fx:id="statusLabel" styleClass="status-info metric-value compact-metric-value" text="Deceased records not loaded yet." wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
