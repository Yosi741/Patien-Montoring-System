<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        spacing="16.0"
        prefWidth="700.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.DeviceFormController" styleClass="panel-card">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="4.0">
            <Label
                    fx:id="titleLabel"
                    text="Device" styleClass="screen-title" />

            <Label
                    text="SQLite-only device registration and assignment foundation."
                    wrapText="true" styleClass="muted-text" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <GridPane hgap="14.0" vgap="13.0">

        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label
                    text="Device ID" styleClass="field-label" />

            <TextField
                    fx:id="deviceIdField"
                    promptText="DEVICE-001" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label
                    text="Device Name" styleClass="field-label" />

            <TextField
                    fx:id="nameField"
                    promptText="Monitor name" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label
                    text="Device Type" styleClass="field-label" />

            <ComboBox
                    fx:id="typeBox"
                    maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label
                    text="Serial Number" styleClass="field-label" />

            <TextField
                    fx:id="serialField"
                    promptText="Serial number" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label
                    text="Status" styleClass="field-label" />

            <ComboBox
                    fx:id="statusBox"
                    maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              GridPane.rowIndex="3">

            <Label
                    text="Notes" styleClass="field-label" />

            <TextArea
                    fx:id="notesArea"
                    prefRowCount="4"
                    wrapText="true"
                    promptText="Optional registration notes" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label
            fx:id="statusLabel"
            text="-"
            wrapText="true" styleClass="status-info metric-value compact-metric-value" />
</VBox>
