<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="panel-card" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.DeviceFormController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <Label fx:id="titleLabel" text="Device" styleClass="section-title" />
    <Label text="SQLite-only device registration and assignment foundation." wrapText="true" styleClass="muted-text" />
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Device ID" styleClass="field-label" />
            <TextField fx:id="deviceIdField" promptText="DEVICE-001" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Device Name" styleClass="field-label" />
            <TextField fx:id="nameField" promptText="Monitor name" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Device Type" styleClass="field-label" />
            <ComboBox fx:id="typeBox" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Serial Number" styleClass="field-label" />
            <TextField fx:id="serialField" promptText="Serial number" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Status" styleClass="field-label" />
            <ComboBox fx:id="statusBox" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
            <Label text="Notes" styleClass="field-label" />
            <TextArea fx:id="notesArea" prefRowCount="4" wrapText="true" promptText="Optional registration notes" />
        </VBox>
    </GridPane>
    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-info" />
</VBox>
