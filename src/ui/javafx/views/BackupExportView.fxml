<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1050.0"
        prefHeight="700.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.BackupExportController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Backup / Export" styleClass="screen-title" />
                <Label text="Local database backup, CSV exports, and restore validation tools" styleClass="muted-text" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane"
                          managed="false"
                          visible="false"
                          spacing="10.0" styleClass="warning-panel">
                        <Label text="Access denied" styleClass="warning-value" />
                        <Label text="Backup and export tools are available only to authorized hospital roles for authorized hospital roles."
                               wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Local only" styleClass="status-info metric-value compact-metric-value" />
                            <Label text="No cloud backup" styleClass="status-success success-value" />
                            <Label text="Restore is preview-only" styleClass="status-info warning-value" />
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <Label text="Backup Safety" styleClass="metric-value compact-metric-value" />

                            <Label text="Create a ZIP backup containing the SQLite database, local uploads, and a backup information file. Existing backups are never overwritten."
                                   wrapText="true" styleClass="body-text" />

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Button fx:id="createBackupButton" text="Create Backup" onAction="#createBackup" styleClass="primary-button" />

                                <Button fx:id="previewRestoreButton" text="Preview Restore Backup" onAction="#previewRestoreBackup" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <Label text="CSV Export Tools" styleClass="metric-value compact-metric-value" />

                            <Label text="Export read-only operational summaries for local review or presentation. CSV files are written with safe escaping."
                                   wrapText="true" styleClass="body-text" />

                            <GridPane hgap="12.0" vgap="12.0">
                                <Button fx:id="exportPatientsButton" text="Export Patients CSV" onAction="#exportPatientsCsv"
                                        GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="secondary-button" />

                                <Button fx:id="exportAlertsButton" text="Export Alerts CSV" onAction="#exportAlertsCsv"
                                        GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="danger-button" />

                                <Button fx:id="exportAuditLogsButton" text="Export Audit Logs CSV" onAction="#exportAuditLogsCsv"
                                        GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="secondary-button" />

                                <Button fx:id="exportMedicationButton" text="Export Medication Events CSV" onAction="#exportMedicationCsv"
                                        GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="secondary-button" />

                                <Button fx:id="exportSchedulingButton" text="Export Scheduling CSV" onAction="#exportSchedulingCsv"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="secondary-button" />
                            </GridPane>
                        </VBox>

                        <VBox spacing="10.0" styleClass="panel-card">
                            <Label text="Result" styleClass="section-title" />

                            <TextArea fx:id="resultArea"
                                      editable="false"
                                      wrapText="true"
                                      prefRowCount="18" styleClass="control-input" />
                        </VBox>

                        <Label fx:id="statusLabel"
                               text="Backup/export tools not loaded yet."
                               wrapText="true" styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
