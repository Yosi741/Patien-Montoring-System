<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="760.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.StaffActivityController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Staff Activity / Shift Overview" styleClass="screen-title" />
                <Label text="Read-only SQLite staff, alert, and handover activity for shift awareness" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0" styleClass="warning-panel">
                        <Label text="Access denied" styleClass="warning-value" />
                        <Label text="Staff Activity is available to Admin, Doctor, and Nurse roles in this JavaFX preview."
                               wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="activityContentPane" spacing="18.0">

                        <Label fx:id="scopeLabel" text="Staff activity scope" wrapText="true" styleClass="status-info metric-value compact-metric-value" />

                        <GridPane hgap="14.0" vgap="14.0">
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0" styleClass="panel-card">
                                <Label text="Logins Today" styleClass="metric-label" />
                                <Label fx:id="loginsTodayLabel" text="0" styleClass="metric-value compact-metric-value" />
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0" styleClass="panel-card">
                                <Label text="Alert Acknowledgements" styleClass="metric-label" />
                                <Label fx:id="alertAckTodayLabel" text="0" styleClass="warning-value" />
                            </VBox>

                            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="6.0" styleClass="panel-card">
                                <Label text="Patient Detail Views" styleClass="metric-label" />
                                <Label fx:id="patientViewsTodayLabel" text="0" styleClass="success-value" />
                            </VBox>

                            <VBox GridPane.columnIndex="3" GridPane.rowIndex="0" spacing="6.0" styleClass="panel-card">
                                <Label text="Sync Operations" styleClass="metric-label" />
                                <Label fx:id="syncTodayLabel" text="0" styleClass="accent-value" />
                            </VBox>

                            <VBox GridPane.columnIndex="4" GridPane.rowIndex="0" spacing="6.0" styleClass="panel-card">
                                <Label text="Recent Actions Today" styleClass="metric-label" />
                                <Label fx:id="recentActionsTodayLabel" text="0" styleClass="metric-value compact-metric-value" />
                            </VBox>
                        </GridPane>

                        <HBox spacing="18.0">
                            <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Active Alerts By Section" styleClass="section-title" />
                                <VBox fx:id="activeAlertsBySectionBox" spacing="8.0" />
                            </VBox>

                            <VBox spacing="12.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Latest Shift Handover Notes" styleClass="section-title" />
                                <VBox fx:id="handoverBox" spacing="8.0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />
                                <TextField fx:id="searchField" promptText="Username, action, or patient ID" HBox.hgrow="ALWAYS" styleClass="control-input" />

                                <Label text="Role" styleClass="field-label" />
                                <ComboBox fx:id="roleFilter" prefWidth="130.0" styleClass="control-input" />

                                <Label text="Action" styleClass="field-label" />
                                <ComboBox fx:id="actionTypeFilter" prefWidth="135.0" styleClass="control-input" />

                                <Label text="Date" styleClass="field-label" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="145.0" styleClass="control-input" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />

                                <Button text="Refresh" onAction="#loadActivity" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0" styleClass="panel-card">
                            <Label text="Staff Activity Log" styleClass="section-title" />

                            <TableView fx:id="activityTable" prefHeight="420.0" styleClass="dialog-card">
                                <columns>
                                    <TableColumn fx:id="timeColumn" text="Time" prefWidth="160.0" />
                                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="140.0" />
                                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="100.0" />
                                    <TableColumn fx:id="actionTypeColumn" text="Action Type" prefWidth="115.0" />
                                    <TableColumn fx:id="descriptionColumn" text="Description / Action" prefWidth="520.0" />
                                    <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="120.0" />
                                </columns>
                            </TableView>
                        </VBox>

                        <Label fx:id="statusLabel" text="Staff activity not loaded yet." styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
