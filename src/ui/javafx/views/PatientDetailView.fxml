<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.PatientDetailController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label fx:id="nameLabel" text="Patient" styleClass="screen-title" />
                <Label text="Read-only SQLite patient detail preview" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="editPatientButton" text="Edit Patient" onAction="#editPatient" styleClass="secondary-button" />
            <Button fx:id="enterVitalsButton" text="Enter Vitals" onAction="#enterVitals" styleClass="primary-button" />
            <Button text="Open Clinical Timeline" onAction="#openClinicalTimeline" styleClass="primary-button" />
            <Button text="Back to Patient List" onAction="#backToPatients" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="detail-scroll-pane">
            <content>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <GridPane hgap="16.0" vgap="16.0">
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="detail-card" spacing="6.0">
                    <Label text="Patient ID" styleClass="metric-label" />
                    <Label fx:id="patientIdLabel" text="-" styleClass="detail-value" />
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="detail-card" spacing="6.0">
                    <Label text="Age / Birth Date" styleClass="metric-label" />
                    <Label fx:id="ageLabel" text="-" styleClass="detail-value" />
                    <Label fx:id="birthDateLabel" text="-" styleClass="muted-text" />
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="detail-card" spacing="6.0">
                    <Label text="Priority" styleClass="metric-label" />
                    <Label fx:id="priorityLabel" text="NORMAL" styleClass="priority-badge" />
                </VBox>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="detail-card" spacing="6.0">
                    <Label text="Gender" styleClass="metric-label" />
                    <Label fx:id="genderLabel" text="-" styleClass="detail-value" />
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="detail-card" spacing="6.0">
                    <Label text="Location" styleClass="metric-label" />
                    <Label fx:id="sectionLabel" text="-" styleClass="detail-value" />
                    <Label fx:id="roomLabel" text="-" styleClass="muted-text" />
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="detail-card" spacing="6.0">
                    <Label text="Status" styleClass="metric-label" />
                    <Label fx:id="statusLabel" text="-" styleClass="detail-value" />
                </VBox>
            </GridPane>
            <VBox spacing="8.0" styleClass="panel-card">
                <Label text="Diagnosis" styleClass="section-title" />
                <Label fx:id="diagnosisLabel" text="No diagnosis recorded" wrapText="true" styleClass="body-text" />
            </VBox>
            <VBox spacing="12.0" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="AI Recommendation" styleClass="section-title" />
                        <Label text="Rule-based decision support only. Not a medical diagnosis." wrapText="true" styleClass="muted-text" />
                    </VBox>
                    <Button text="Generate Recommendation" onAction="#generateAiRecommendation" styleClass="primary-button" />
                </HBox>
                <GridPane hgap="14.0" vgap="10.0">
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="trend-summary-card" spacing="4.0">
                        <Label text="Risk Score" styleClass="metric-label" />
                        <Label fx:id="aiRiskLabel" text="Not generated" styleClass="detail-value" />
                        <Label fx:id="aiRecommendationTimeLabel" text="-" styleClass="muted-text" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="trend-summary-card" spacing="4.0">
                        <Label text="Latest Recommendation" styleClass="metric-label" />
                        <Label fx:id="aiRecommendationLabel" text="No AI recommendation has been generated for this patient yet." wrapText="true" styleClass="body-text" />
                    </VBox>
                </GridPane>
                <Label fx:id="aiRecommendationStatusLabel" text="Rule-based decision support only. Not a medical diagnosis." wrapText="true" styleClass="status-pill" />
            </VBox>
            <HBox spacing="14.0" styleClass="panel-card">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Patient Alert Summary" styleClass="section-title" />
                    <Label text="Read-only SQLite alert context. JavaFX acknowledgement remains SQLite-only." wrapText="true" styleClass="muted-text" />
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Active Alerts" styleClass="metric-label" />
                    <Label fx:id="activeAlertCountLabel" text="0" styleClass="metric-value compact-metric-value warning-value" />
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Latest Alert" styleClass="metric-label" />
                    <Label fx:id="latestAlertSeverityLabel" text="No alerts recorded" />
                    <Label fx:id="latestAlertTimeLabel" text="-" styleClass="muted-text" />
                </VBox>
                <Button text="View Patient Alerts" onAction="#viewPatientAlerts" styleClass="primary-button" />
            </HBox>
            <HBox spacing="14.0" styleClass="panel-card">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Medication Context" styleClass="section-title" />
                    <Label text="Open the SQLite medication overview or use controlled medication write actions for this patient." wrapText="true" styleClass="muted-text" />
                </VBox>
                <Button fx:id="addMedicationButton" text="Add Medication" onAction="#addPatientMedication" styleClass="secondary-button" />
                <Button fx:id="recordMedicationButton" text="Record Given" onAction="#recordPatientMedicationGiven" styleClass="primary-button" />
                <Button text="View Medications" onAction="#viewPatientMedications" styleClass="primary-button" />
            </HBox>
            <HBox spacing="14.0" styleClass="panel-card">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Assigned Devices" styleClass="section-title" />
                    <Label text="Open the SQLite medical device registration and assignment screen filtered to this patient." wrapText="true" styleClass="muted-text" />
                </VBox>
                <Button text="Assign Device" onAction="#assignPatientDevice" styleClass="primary-button" />
                <Button text="View Devices" onAction="#viewPatientDevices" styleClass="secondary-button" />
            </HBox>
            <HBox spacing="14.0" styleClass="panel-card">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Appointments &amp; Reminders" styleClass="section-title" />
                    <Label text="Open SQLite scheduling filtered to this patient or create controlled scheduling items." wrapText="true" styleClass="muted-text" />
                </VBox>
                <Button fx:id="createAppointmentButton" text="Create Appointment" onAction="#createPatientAppointment" styleClass="primary-button" />
                <Button fx:id="createReminderButton" text="Create Reminder" onAction="#createPatientReminder" styleClass="secondary-button" />
                <Button text="View Schedule" onAction="#viewPatientScheduling" styleClass="secondary-button" />
            </HBox>
            <HBox spacing="14.0" styleClass="panel-card">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Medical Files" styleClass="section-title" />
                    <Label text="Upload and review SQLite medical file metadata, summaries, and timeline FILE events." wrapText="true" styleClass="muted-text" />
                </VBox>
                <Button fx:id="uploadMedicalFileButton" text="Upload Medical File" onAction="#uploadPatientMedicalFile" styleClass="primary-button" />
                <Button text="View Medical Files" onAction="#viewPatientMedicalFiles" styleClass="secondary-button" />
            </HBox>
            <VBox spacing="12.0" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="3.0">
                        <Label text="Vital Trend Chart" styleClass="section-title" />
                        <Label text="Read-only SQLite visualization with basic rule-based status indicators." styleClass="muted-text" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Vital" styleClass="field-label" />
                    <ComboBox fx:id="trendVitalTypeFilter" prefWidth="165.0" />
                    <Label text="Range" styleClass="field-label" />
                    <ComboBox fx:id="trendRangeFilter" prefWidth="145.0" />
                    <Button text="Refresh Chart" onAction="#loadTrendChart" styleClass="secondary-button" />
                </HBox>
                <LineChart fx:id="vitalsTrendChart" legendVisible="true" prefHeight="280.0">
                    <xAxis>
                        <NumberAxis fx:id="trendXAxis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="trendYAxis" />
                    </yAxis>
                </LineChart>
                <GridPane hgap="14.0" vgap="10.0">
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="trend-summary-card" spacing="4.0">
                        <Label text="Latest Reading" styleClass="metric-label" />
                        <Label fx:id="latestValueLabel" text="-" styleClass="detail-value" />
                        <Label fx:id="latestMetaLabel" text="No latest reading available." wrapText="true" styleClass="muted-text" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="trend-summary-card" spacing="4.0">
                        <Label text="Trend Statistics" styleClass="metric-label" />
                        <Label fx:id="trendStatsLabel" text="Min: - | Max: - | Avg: -" wrapText="true" styleClass="detail-value" />
                        <Label fx:id="trendCountsLabel" text="Normal: 0 | Warning: 0 | Critical: 0" wrapText="true" styleClass="muted-text" />
                    </VBox>
                </GridPane>
                <Label fx:id="trendStatusLabel" text="Trend chart not loaded yet." styleClass="status-pill" />
            </VBox>
            <VBox spacing="12.0" styleClass="panel-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Vitals Timeline" styleClass="section-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Type" styleClass="field-label" />
                    <ComboBox fx:id="vitalTypeFilter" prefWidth="180.0" />
                    <Button text="Refresh" onAction="#loadVitals" styleClass="secondary-button" />
                </HBox>
                <TableView fx:id="vitalsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="140.0" />
                        <TableColumn fx:id="valueColumn" text="Value" prefWidth="110.0" />
                        <TableColumn fx:id="unitColumn" text="Unit" prefWidth="90.0" />
                        <TableColumn fx:id="timeColumn" text="Recorded Time" prefWidth="190.0" />
                        <TableColumn fx:id="sourceColumn" text="Source" prefWidth="120.0" />
                        <TableColumn fx:id="staffColumn" text="Staff User" prefWidth="140.0" />
                        <TableColumn fx:id="deviceColumn" text="Device ID" prefWidth="150.0" />
                    </columns>
                </TableView>
                <Label fx:id="timelineStatusLabel" text="Vital readings loaded from SQLite: 0" styleClass="status-pill" />
            </VBox>
        </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
