<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="760.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.PatientDetailController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label fx:id="nameLabel" text="Patient"
                       style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Read-only SQLite patient detail preview"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="editPatientButton" text="Edit Patient" onAction="#editPatient"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button fx:id="movePatientButton" text="Move Patient" onAction="#movePatientRoom"
                    style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button fx:id="enterVitalsButton" text="Enter Vitals" onAction="#enterVitals"
                    style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button fx:id="markDeceasedButton" text="Mark Deceased" onAction="#markPatientDeceased"
                    style="-fx-background-color: #FFEBEE; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button fx:id="viewNewbornsButton" text="View Newborns" onAction="#viewPatientNewborns"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button text="Open Clinical Timeline" onAction="#openClinicalTimeline"
                    style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
            <Button text="Back to Patient List" onAction="#backToPatients"
                    style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <GridPane hgap="16.0" vgap="16.0">
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Patient ID" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="patientIdLabel" text="-" style="-fx-text-fill: #0D47A1; -fx-font-size: 20px; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Age / Birth Date" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="ageLabel" text="-" style="-fx-text-fill: #263238; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Label fx:id="birthDateLabel" text="-" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
                        </VBox>

                        <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Priority" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="priorityLabel" text="NORMAL"
                                   style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 7 14; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Gender" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="genderLabel" text="-" style="-fx-text-fill: #263238; -fx-font-size: 20px; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Location" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="sectionLabel" text="-" style="-fx-text-fill: #263238; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Label fx:id="roomLabel" text="-" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
                        </VBox>

                        <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 260; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <Label text="Status" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="statusLabel" text="-" style="-fx-text-fill: #00695C; -fx-font-size: 20px; -fx-font-weight: bold;" />
                        </VBox>
                    </GridPane>

                    <VBox spacing="8.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                        <Label text="Diagnosis" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                        <Label fx:id="diagnosisLabel" text="No diagnosis recorded" wrapText="true"
                               style="-fx-text-fill: #455A64; -fx-font-size: 14px;" />
                    </VBox>

                    <!-- باقي الأقسام خليتها بنفس الـ fx:id والـ onAction لكن بتصميم أنظف -->
                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label text="AI Recommendation" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <Label text="Rule-based decision support only. Not a medical diagnosis." wrapText="true"
                                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
                            </VBox>
                            <Button text="Generate Recommendation" onAction="#generateAiRecommendation"
                                    style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                        </HBox>

                        <GridPane hgap="14.0" vgap="10.0">
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="4.0"
                                  style="-fx-background-color: #FAFCFD; -fx-background-radius: 16; -fx-padding: 14;">
                                <Label text="Risk Score" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="aiRiskLabel" text="Not generated" style="-fx-text-fill: #0D47A1; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                <Label fx:id="aiRecommendationTimeLabel" text="-" style="-fx-text-fill: #607D8B; -fx-font-size: 12px;" />
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="4.0"
                                  style="-fx-background-color: #FAFCFD; -fx-background-radius: 16; -fx-padding: 14;">
                                <Label text="Latest Recommendation" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="aiRecommendationLabel" text="No AI recommendation has been generated for this patient yet." wrapText="true"
                                       style="-fx-text-fill: #455A64; -fx-font-size: 14px;" />
                            </VBox>
                        </GridPane>

                        <Label fx:id="aiRecommendationStatusLabel" text="Rule-based decision support only. Not a medical diagnosis." wrapText="true"
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>

                    <HBox spacing="14.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Patient Alert Summary" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                            <Label text="Read-only SQLite alert context. JavaFX acknowledgement remains SQLite-only." wrapText="true"
                                   style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Active Alerts" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="activeAlertCountLabel" text="0" style="-fx-text-fill: #E65100; -fx-font-size: 26px; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Latest Alert" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Label fx:id="latestAlertSeverityLabel" text="No alerts recorded" />
                            <Label fx:id="latestAlertTimeLabel" text="-" style="-fx-text-fill: #607D8B; -fx-font-size: 12px;" />
                        </VBox>
                        <Button text="View Patient Alerts" onAction="#viewPatientAlerts"
                                style="-fx-background-color: #FFEBEE; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                    </HBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="3.0">
                                <Label text="Vital Trend Chart" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <Label text="Read-only SQLite visualization with basic rule-based status indicators."
                                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Vital" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                            <ComboBox fx:id="trendVitalTypeFilter" prefWidth="165.0" />
                            <Label text="Range" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                            <ComboBox fx:id="trendRangeFilter" prefWidth="145.0" />
                            <Button text="Refresh Chart" onAction="#loadTrendChart"
                                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                        </HBox>

                        <LineChart fx:id="vitalsTrendChart" legendVisible="true" prefHeight="280.0">
                            <xAxis><NumberAxis fx:id="trendXAxis" /></xAxis>
                            <yAxis><NumberAxis fx:id="trendYAxis" /></yAxis>
                        </LineChart>

                        <Label fx:id="trendStatusLabel" text="Trend chart not loaded yet."
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);"
                          VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label text="Vitals Timeline" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Type" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                            <ComboBox fx:id="vitalTypeFilter" prefWidth="180.0" />
                            <Button text="Refresh" onAction="#loadVitals"
                                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                        </HBox>

                        <TableView fx:id="vitalsTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-border-color: #E0E7EF; -fx-border-radius: 14; -fx-background-radius: 14;">
                            <columns>
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="140.0" />
                                <TableColumn fx:id="valueColumn" text="Value" prefWidth="110.0" />
                                <TableColumn fx:id="unitColumn" text="Unit" prefWidth="90.0" />
                                <TableColumn fx:id="timeColumn" text="Recorded Time" prefWidth="190.0" />
                                <TableColumn fx:id="sourceColumn" text="Source" prefWidth="120.0" />
                                <TableColumn fx:id="staffColumn" text="Staff User" prefWidth="140.0" />
                                <TableColumn fx:id="deviceColumn" text="Device ID" prefWidth="150.0" />
                            </columns>
                        </TableView>

                        <Label fx:id="timelineStatusLabel" text="Vital readings loaded from SQLite: 0"
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
