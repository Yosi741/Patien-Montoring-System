<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.UserDirectoryController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Staff/User Directory" styleClass="screen-title" />
                <Label text="Read-only SQLite staff directory for Admin users" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <VBox fx:id="accessDeniedPane" spacing="10.0" styleClass="panel-card" managed="false" visible="false">
                <Label text="Access denied" styleClass="section-title" />
                <Label text="The Staff/User Directory is visible only for Admin users in this JavaFX preview." wrapText="true" styleClass="body-text" />
            </VBox>
            <VBox fx:id="directoryContentPane" spacing="14.0">
                <VBox spacing="12.0" styleClass="panel-card patient-filter-panel">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Search" styleClass="field-label" />
                        <TextField fx:id="searchField" promptText="Username" HBox.hgrow="ALWAYS" />
                        <Label text="Role" styleClass="field-label" />
                        <ComboBox fx:id="roleFilter" prefWidth="130.0" />
                        <Label text="Section" styleClass="field-label" />
                        <ComboBox fx:id="sectionFilter" prefWidth="150.0" />
                        <Label text="Status" styleClass="field-label" />
                        <ComboBox fx:id="activeFilter" prefWidth="130.0" />
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />
                        <Button text="Refresh" onAction="#loadUsers" styleClass="secondary-button" />
                    </HBox>
                </VBox>
                <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS">
                    <TableView fx:id="userTable">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="75.0" />
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180.0" />
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="190.0" />
                            <TableColumn fx:id="sectionColumn" text="Section / Department" prefWidth="180.0" />
                            <TableColumn fx:id="activeColumn" text="Active" prefWidth="100.0" />
                            <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="185.0" />
                        </columns>
                    </TableView>
                    <ScrollPane fitToWidth="true" styleClass="detail-scroll-pane">
                        <VBox spacing="16.0" styleClass="panel-card">
                            <Label fx:id="detailTitleLabel" text="Select a staff user" styleClass="section-title" wrapText="true" />
                            <Label fx:id="detailRoleBadgeLabel" text="UNKNOWN" styleClass="role-unknown" />
                            <GridPane hgap="12.0" vgap="10.0">
                                <Label text="Username" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="detailUsernameLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label text="Role" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="detailRoleLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Section" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="detailSectionLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="Status" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="detailStatusLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="Auth Source" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="detailAuthSourceLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label text="Created At" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <Label fx:id="detailCreatedAtLabel" text="-" styleClass="detail-field-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </GridPane>
                            <VBox spacing="8.0">
                                <Label text="Permission Preview" styleClass="section-title" />
                                <VBox fx:id="permissionListBox" spacing="8.0" />
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </SplitPane>
                <Label fx:id="statusLabel" text="SQLite users loaded: 0" styleClass="status-pill" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
