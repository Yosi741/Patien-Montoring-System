<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1150.0"
        prefHeight="720.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.UserDirectoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label text="Staff/User Directory"
                       style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Read-only SQLite staff directory for Admin users"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 18; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0"
                  style="-fx-background-color: #FFF3E0; -fx-background-radius: 18; -fx-padding: 20; -fx-border-color: #FFCC80; -fx-border-radius: 18;">
                <Label text="Access denied"
                       style="-fx-text-fill: #E65100; -fx-font-size: 18px; -fx-font-weight: bold;" />
                <Label text="The Staff/User Directory is visible only for Admin users in this JavaFX preview."
                       wrapText="true"
                       style="-fx-text-fill: #5D4037; -fx-font-size: 14px;" />
            </VBox>

            <VBox fx:id="directoryContentPane" spacing="16.0">

                <VBox spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Search" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                        <TextField fx:id="searchField" promptText="Username" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC; -fx-padding: 10 12; -fx-font-size: 14px;" />

                        <Label text="Role" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                        <ComboBox fx:id="roleFilter" prefWidth="130.0"
                                  style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                        <Label text="Section" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                        <ComboBox fx:id="sectionFilter" prefWidth="150.0"
                                  style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                        <Label text="Status" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                        <ComboBox fx:id="activeFilter" prefWidth="130.0"
                                  style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button text="Clear Filters" onAction="#clearFilters"
                                style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                        <Button text="Refresh" onAction="#loadUsers"
                                style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">

                    <VBox spacing="10.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">

                        <Label text="Staff Users"
                               style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />

                        <TableView fx:id="userTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-border-color: #E0E7EF; -fx-border-radius: 14; -fx-background-radius: 14;">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="75.0" />
                                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180.0" />
                                <TableColumn fx:id="roleColumn" text="Role" prefWidth="190.0" />
                                <TableColumn fx:id="sectionColumn" text="Section / Department" prefWidth="180.0" />
                                <TableColumn fx:id="activeColumn" text="Active" prefWidth="100.0" />
                                <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="185.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox spacing="16.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">

                                <Label fx:id="detailTitleLabel" text="Select a staff user" wrapText="true"
                                       style="-fx-text-fill: #0D47A1; -fx-font-size: 20px; -fx-font-weight: bold;" />

                                <Label fx:id="detailRoleBadgeLabel" text="UNKNOWN"
                                       style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 7 14; -fx-font-weight: bold;" />

                                <GridPane hgap="12.0" vgap="12.0">
                                    <Label text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailUsernameLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                           style="-fx-text-fill: #263238; -fx-font-size: 14px; -fx-font-weight: bold;" />

                                    <Label text="Role" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailRoleLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           style="-fx-text-fill: #263238; -fx-font-size: 14px; -fx-font-weight: bold;" />

                                    <Label text="Section" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailSectionLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-text-fill: #263238; -fx-font-size: 14px; -fx-font-weight: bold;" />

                                    <Label text="Status" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailStatusLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                           style="-fx-text-fill: #00695C; -fx-font-size: 14px; -fx-font-weight: bold;" />

                                    <Label text="Auth Source" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailAuthSourceLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                           style="-fx-text-fill: #263238; -fx-font-size: 14px;" />

                                    <Label text="Created At" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                           style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="detailCreatedAtLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                           style="-fx-text-fill: #263238; -fx-font-size: 14px;" />
                                </GridPane>

                                <VBox spacing="10.0"
                                      style="-fx-background-color: #FAFCFD; -fx-background-radius: 16; -fx-padding: 16; -fx-border-color: #E0E7EF; -fx-border-radius: 16;">
                                    <Label text="Permission Preview"
                                           style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                    <VBox fx:id="permissionListBox" spacing="8.0" />
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </SplitPane>

                <Label fx:id="statusLabel" text="SQLite users loaded: 0"
                       style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>