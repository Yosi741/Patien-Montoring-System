<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1150.0"
        prefHeight="720.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.UserDirectoryController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Staff/User Directory" styleClass="screen-title" />
                <Label text="Read-only SQLite staff directory for Admin users" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0" styleClass="warning-panel">
                <Label text="Access denied" styleClass="warning-value" />
                <Label text="The Staff/User Directory is visible only for Admin users in this JavaFX preview."
                       wrapText="true" styleClass="body-text" />
            </VBox>

            <VBox fx:id="directoryContentPane" spacing="16.0">

                <VBox spacing="12.0" styleClass="panel-card">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Search" styleClass="field-label" />
                        <TextField fx:id="searchField" promptText="Username" HBox.hgrow="ALWAYS" styleClass="control-input" />

                        <Label text="Role" styleClass="field-label" />
                        <ComboBox fx:id="roleFilter" prefWidth="130.0" styleClass="control-input" />

                        <Label text="Section" styleClass="field-label" />
                        <ComboBox fx:id="sectionFilter" prefWidth="150.0" styleClass="control-input" />

                        <Label text="Status" styleClass="field-label" />
                        <ComboBox fx:id="activeFilter" prefWidth="130.0" styleClass="control-input" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />

                        <Button text="Refresh" onAction="#loadUsers" styleClass="secondary-button" />
                    </HBox>
                </VBox>

                <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS" styleClass="transparent-pane">

                    <VBox spacing="10.0" styleClass="panel-card">

                        <Label text="Staff Users" styleClass="section-title" />

                        <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="dialog-card">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="75.0" />
                                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180.0" />
                                <TableColumn fx:id="roleColumn" text="Role" prefWidth="190.0" />
                                <TableColumn fx:id="sectionColumn" text="Section / Department" prefWidth="180.0" />
                                <TableColumn fx:id="activeColumn" text="Active" prefWidth="100.0" />
                                <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="185.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <ScrollPane fitToWidth="true" styleClass="scroll-clear">
                        <content>
                            <VBox spacing="16.0" styleClass="panel-card">

                                <Label fx:id="detailTitleLabel" text="Select a staff user" wrapText="true" styleClass="detail-value" />

                                <Label fx:id="detailRoleBadgeLabel" text="UNKNOWN" styleClass="status-info metric-value compact-metric-value" />

                                <GridPane hgap="12.0" vgap="12.0">
                                    <Label text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="metric-label" />
                                    <Label fx:id="detailUsernameLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="compact-detail-value" />

                                    <Label text="Role" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="metric-label" />
                                    <Label fx:id="detailRoleLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="compact-detail-value" />

                                    <Label text="Section" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="metric-label" />
                                    <Label fx:id="detailSectionLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="compact-detail-value" />

                                    <Label text="Status" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="metric-label" />
                                    <Label fx:id="detailStatusLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="success-value" />

                                    <Label text="Auth Source" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="metric-label" />
                                    <Label fx:id="detailAuthSourceLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="compact-detail-value" />

                                    <Label text="Created At" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="metric-label" />
                                    <Label fx:id="detailCreatedAtLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="compact-detail-value" />
                                </GridPane>

                                <VBox spacing="10.0" styleClass="control-input">
                                    <Label text="Permission Preview" styleClass="section-title" />
                                    <VBox fx:id="permissionListBox" spacing="8.0" />
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </SplitPane>

                <Label fx:id="statusLabel" text="SQLite users loaded: 0" styleClass="status-info metric-value compact-metric-value" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
