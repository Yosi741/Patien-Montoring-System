<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200.0" prefHeight="760.0"
            xmlns="http://javafx.com/javafx/17.0.15"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.javafx.controllers.NewbornRecordsController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Newborn Records" styleClass="screen-title" />
                <Label text="Newborn management and local HTML birth certificate foundation" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#backToDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

                    <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0" styleClass="warning-panel">
                        <Label text="Access denied" styleClass="warning-value" />
                        <Label text="Newborn records are available to Admin, Doctor, and Nurse roles."
                               wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">
                        <HBox spacing="14.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Total Newborns" styleClass="metric-label" />
                                <Label fx:id="totalNewbornsLabel" text="0" styleClass="screen-title" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Births Today" styleClass="metric-label" />
                                <Label fx:id="birthsTodayLabel" text="0" styleClass="success-value" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Births This Month" styleClass="metric-label" />
                                <Label fx:id="birthsThisMonthLabel" text="0" styleClass="screen-title" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Certificates Generated" styleClass="metric-label" />
                                <Label fx:id="certificatesGeneratedLabel" text="0" styleClass="success-value" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Pending Certificates" styleClass="metric-label" />
                                <Label fx:id="pendingCertificatesLabel" text="0" styleClass="warning-value" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />
                                <TextField fx:id="searchField" promptText="Newborn ID, baby name, or mother" HBox.hgrow="ALWAYS" styleClass="control-input" />
                                <Label text="Date" styleClass="field-label" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="145.0" />
                                <Label text="Section" styleClass="field-label" />
                                <ComboBox fx:id="sectionFilter" prefWidth="160.0" />
                                <Label text="Gender" styleClass="field-label" />
                                <ComboBox fx:id="genderFilter" prefWidth="120.0" />
                            </HBox>
                            <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
                                <Label fx:id="motherFilterLabel" text="" styleClass="status-info metric-value compact-metric-value" />
                                <Button fx:id="addNewbornButton" text="Add Newborn" onAction="#addNewborn" styleClass="primary-button" />
                                <Button fx:id="editNewbornButton" text="Edit Selected" onAction="#editNewborn" styleClass="secondary-button" />
                                <Button fx:id="generateCertificateButton" text="Generate Certificate" onAction="#generateCertificate" styleClass="secondary-button" />
                                <Button fx:id="openCertificateButton" text="Open Certificate" onAction="#openCertificate" styleClass="secondary-button" />
                                <Button fx:id="sendBirthNoticeButton" text="Send Birth Notice" onAction="#sendBirthNotice" styleClass="secondary-button" />
                                <Button fx:id="copySummaryButton" text="Copy Summary" onAction="#copySummary" styleClass="secondary-button" />
                                <Button text="Clear" onAction="#clearFilters" styleClass="secondary-button" />
                            </FlowPane>
                        </VBox>

                        <HBox spacing="18.0">
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                <Label text="Records" styleClass="section-title" />
                                <TableView fx:id="newbornTable" prefHeight="500.0">
                                    <columns>
                                        <TableColumn fx:id="newbornIdColumn" text="Newborn ID" prefWidth="110.0" />
                                        <TableColumn fx:id="babyNameColumn" text="Baby Name" prefWidth="150.0" />
                                        <TableColumn fx:id="genderColumn" text="Gender" prefWidth="90.0" />
                                        <TableColumn fx:id="birthTimeColumn" text="Birth Time" prefWidth="160.0" />
                                        <TableColumn fx:id="motherColumn" text="Mother" prefWidth="220.0" />
                                        <TableColumn fx:id="roomColumn" text="Room" prefWidth="90.0" />
                                        <TableColumn fx:id="sectionColumn" text="Section" prefWidth="120.0" />
                                        <TableColumn fx:id="certificateColumn" text="Certificate" prefWidth="130.0" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="12.0" prefWidth="360.0" styleClass="panel-card">
                                <Label text="Newborn Detail" styleClass="section-title" />
                                <Label text="Baby" styleClass="metric-label" />
                                <Label fx:id="detailBabyLabel" text="No newborn selected" wrapText="true" />
                                <Label text="Mother / Father" styleClass="metric-label" />
                                <Label fx:id="detailMotherLabel" text="-" wrapText="true" />
                                <Button fx:id="viewMotherFileButton" text="View Mother File" onAction="#viewMotherFile" maxWidth="Infinity" styleClass="secondary-button" />
                                <Label text="Birth Time" styleClass="metric-label" />
                                <Label fx:id="detailBirthLabel" text="-" wrapText="true" />
                                <Label text="Measurements" styleClass="metric-label" />
                                <Label fx:id="detailMeasurementsLabel" text="-" wrapText="true" />
                                <Label text="Delivery / Location" styleClass="metric-label" />
                                <Label fx:id="detailDeliveryLabel" text="-" wrapText="true" />
                                <Label text="Certificate Path" styleClass="metric-label" />
                                <Label fx:id="detailCertificateLabel" text="-" wrapText="true" />
                                <Label text="Notes" styleClass="metric-label" />
                                <Label fx:id="detailNotesLabel" text="Select a newborn record to view details." wrapText="true" />
                            </VBox>
                        </HBox>

                        <Label fx:id="statusLabel" text="Newborn records not loaded yet." wrapText="true" styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
