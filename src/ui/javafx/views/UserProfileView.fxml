<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1050.0"
        prefHeight="680.0"
        styleClass="content-page"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.UserProfileController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Staff Profile"
                       styleClass="screen-title" />
                <Label text="JavaFX session, safe profile fields, and permission preview"
                       styleClass="muted-text" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard" onAction="#goDashboard"
                    styleClass="secondary-button" />

        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <GridPane hgap="16.0" vgap="16.0">
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Username" styleClass="metric-label" />
                    <Label fx:id="usernameLabel" text="-" styleClass="detail-value" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Role" styleClass="metric-label" />
                    <Label fx:id="roleLabel" text="-" styleClass="detail-value" />
                    <Label fx:id="roleBadgeLabel" text="UNKNOWN"
                           styleClass="status-info" />
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Section / Department" styleClass="metric-label" />
                    <Label fx:id="sectionLabel" text="-" styleClass="detail-value" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Account Status" styleClass="metric-label" />
                    <Label fx:id="accountStatusLabel" text="-" styleClass="detail-value success-value" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Login Source" styleClass="metric-label" />
                    <Label fx:id="authSourceLabel" text="-" styleClass="detail-value accent-value" />
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" spacing="6.0"
                      styleClass="metric-card">
                    <Label text="Login Time" styleClass="metric-label" />
                    <Label fx:id="loginTimeLabel" text="-" styleClass="section-title" />
                </VBox>
            </GridPane>

            <VBox spacing="12.0"
                  styleClass="panel-card">
                <Label text="Contact &amp; Security"
                       styleClass="section-title" />

                <GridPane hgap="14.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Email" styleClass="metric-label" />
                        <TextField fx:id="emailField" promptText="name@hospital.local"
                                   styleClass="control-input" />
                    </VBox>

                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Phone" styleClass="metric-label" />
                        <TextField fx:id="phoneField" promptText="Department phone or extension"
                                   styleClass="control-input" />
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button text="Save Profile" onAction="#saveProfile"
                            styleClass="primary-button" />
                    <Button text="Change Password" onAction="#changePassword"
                            styleClass="secondary-button" />
                    <Label fx:id="profileStatusLabel" text="Passwords are never displayed."
                           wrapText="true"
                           styleClass="status-info" />
                </HBox>
            </VBox>

            <VBox spacing="12.0"
                  styleClass="panel-card">
                <Label text="Permission Preview"
                       styleClass="section-title" />

                <Label text="This panel previews intended JavaFX permissions. Full enforcement will be added in a later safe phase."
                       wrapText="true"
                       styleClass="muted-text" />

                <VBox fx:id="permissionListBox" spacing="8.0" />
            </VBox>

            <VBox fx:id="writeFoundationBox"
                  managed="false"
                  visible="false"
                  spacing="12.0"
                  styleClass="panel-card">

                <Label text="Write Workflow Foundation"
                       styleClass="section-title" />

                <Label text="Admin-only safe test write. This creates an SQLite audit log row only; no patient, vitals, medication, or user data is changed."
                       wrapText="true"
                       styleClass="muted-text" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="createTestAuditButton"
                            text="Create Test Audit Event"
                            onAction="#createTestAuditEvent"
                            styleClass="primary-button" />

                    <Label fx:id="writeFoundationStatusLabel"
                           text="-"
                           wrapText="true" styleClass="status-success success-value" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
