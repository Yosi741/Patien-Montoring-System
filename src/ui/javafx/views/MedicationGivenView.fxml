<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="700.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicationGivenController" styleClass="panel-card">

    <VBox spacing="4.0">
        <Label
                text="Record Medication Given" styleClass="screen-title" />

        <Label
                text="Records a medication administration event only. System data is stored in the local database."
                wrapText="true" styleClass="muted-text" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">

        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label
                    text="Patient ID" styleClass="field-label" />

            <Label
                    fx:id="patientIdLabel"
                    text="-" styleClass="status-info metric-value compact-metric-value" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label
                    text="Medication" styleClass="field-label" />

            <ComboBox
                    fx:id="medicationBox"
                    maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label
                    text="Given By" styleClass="field-label" />

            <TextField
                    fx:id="givenByField"
                    promptText="Doctor or nurse username" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label
                    text="Given At" styleClass="field-label" />

            <TextField
                    fx:id="givenAtField"
                    promptText="dd-MM-yyyy HH:mm:ss" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label
                    text="Status" styleClass="field-label" />

            <ComboBox
                    fx:id="statusBox"
                    maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              GridPane.rowIndex="3">

            <Label
                    text="Notes" styleClass="field-label" />

            <TextArea
                    fx:id="notesArea"
                    prefRowCount="4"
                    wrapText="true"
                    promptText="Optional administration note" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label
            fx:id="statusLabel"
            text="-"
            wrapText="true" styleClass="status-success success-value" />
</VBox>
