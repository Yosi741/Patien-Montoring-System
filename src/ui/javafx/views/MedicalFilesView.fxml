<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.MedicalFilesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Medical Files" styleClass="screen-title" />
                <Label text="SQLite upload and local basic analysis preview" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="detail-scroll-pane">
            <content>
                <VBox spacing="16.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <VBox fx:id="accessDeniedPane" spacing="10.0" styleClass="panel-card" managed="false" visible="false">
                        <Label text="Access denied" styleClass="section-title" />
                        <Label text="Medical Files is available to Admin, Doctor, and Nurse roles in this JavaFX preview." wrapText="true" styleClass="body-text" />
                    </VBox>
                    <VBox fx:id="contentPane" spacing="16.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="SQLite-only upload. No OCR, no external AI, no legacy text-file writeback." styleClass="status-pill" />
                            <Label fx:id="patientFilterChip" text="" styleClass="filter-chip" managed="false" visible="false" />
                            <Button fx:id="clearPatientFilterButton" text="Clear Patient Filter" onAction="#clearPatientFilter" styleClass="secondary-button" managed="false" visible="false" />
                        </HBox>
                        <VBox spacing="12.0" styleClass="panel-card patient-filter-panel">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />
                                <TextField fx:id="searchField" promptText="Patient ID, patient name, original filename, uploaded by" HBox.hgrow="ALWAYS" />
                                <Label text="Category" styleClass="field-label" />
                                <ComboBox fx:id="categoryFilter" prefWidth="180.0" />
                                <Label text="Date" styleClass="field-label" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="135.0" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Uploaded By" styleClass="field-label" />
                                <TextField fx:id="uploadedByFilter" promptText="Username" prefWidth="220.0" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="uploadButton" text="Upload Medical File" onAction="#uploadFile" styleClass="primary-button" />
                                <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />
                                <Button text="Refresh" onAction="#loadFiles" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <SplitPane dividerPositions="0.63" prefHeight="620.0">
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Uploaded Files" styleClass="section-title" />
                                <TableView fx:id="filesTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="115.0" />
                                        <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="180.0" />
                                        <TableColumn fx:id="originalNameColumn" text="Original Name" prefWidth="220.0" />
                                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150.0" />
                                        <TableColumn fx:id="uploadedByColumn" text="Uploaded By" prefWidth="140.0" />
                                        <TableColumn fx:id="uploadedAtColumn" text="Uploaded At" prefWidth="170.0" />
                                        <TableColumn fx:id="fileSizeColumn" text="Size" prefWidth="110.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                            <VBox spacing="12.0" styleClass="panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="detailTitleLabel" text="Select a file" styleClass="section-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="copySummaryButton" text="Copy Summary" onAction="#copySummary" styleClass="secondary-button" disable="true" />
                                    <Button fx:id="openFileButton" text="Open File" onAction="#openSelectedFile" styleClass="secondary-button" disable="true" />
                                    <Button fx:id="aiSummaryButton" text="Generate AI Summary Note" onAction="#generateAiSummaryNote" styleClass="secondary-button" disable="true" />
                                </HBox>
                                <Label text="File ID" styleClass="field-label" />
                                <Label fx:id="fileIdLabel" text="-" wrapText="true" styleClass="muted-text" />
                                <Label text="Patient" styleClass="field-label" />
                                <Label fx:id="patientLabel" text="-" wrapText="true" styleClass="muted-text" />
                                <Label text="Original Name" styleClass="field-label" />
                                <Label fx:id="originalNameLabel" text="-" wrapText="true" styleClass="muted-text" />
                                <Label text="Stored Path" styleClass="field-label" />
                                <Label fx:id="storedPathLabel" text="-" wrapText="true" styleClass="muted-text" />
                                <HBox spacing="16.0">
                                    <VBox spacing="4.0">
                                        <Label text="Category" styleClass="field-label" />
                                        <Label fx:id="categoryLabel" text="-" styleClass="muted-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded By" styleClass="field-label" />
                                        <Label fx:id="uploadedByLabel" text="-" styleClass="muted-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded At" styleClass="field-label" />
                                        <Label fx:id="uploadedAtLabel" text="-" styleClass="muted-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Size" styleClass="field-label" />
                                        <Label fx:id="fileSizeLabel" text="-" styleClass="muted-text" />
                                    </VBox>
                                </HBox>
                                <Label text="Extracted Summary" styleClass="field-label" />
                                <TextArea fx:id="summaryArea" editable="false" wrapText="true" prefRowCount="7" />
                                <Label text="Notes" styleClass="field-label" />
                                <TextArea fx:id="notesArea" editable="false" wrapText="true" prefRowCount="4" />
                                <HBox spacing="8.0">
                                    <Label text="Safe Preview" styleClass="field-label" />
                                    <Label fx:id="previewTypeLabel" text="-" styleClass="filter-chip" />
                                </HBox>
                                <ImageView fx:id="previewImageView" fitHeight="300.0" fitWidth="520.0" preserveRatio="true" smooth="true" managed="false" visible="false" />
                                <TextArea fx:id="previewArea" editable="false" wrapText="true" prefRowCount="8" text="Select a medical file to load a safe local preview." />
                            </VBox>
                        </SplitPane>
                        <Label fx:id="statusLabel" text="Medical files not loaded yet." wrapText="true" styleClass="status-pill" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
