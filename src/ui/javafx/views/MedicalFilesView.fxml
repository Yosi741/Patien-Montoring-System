<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1180.0"
        prefHeight="740.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicalFilesController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Medical Files" styleClass="screen-title" />
                <Label text="SQLite upload and local basic analysis preview" styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0" styleClass="warning-panel">
                        <Label text="Access denied" styleClass="warning-value" />
                        <Label text="Medical Files is available to Admin, Doctor, and Nurse roles in this JavaFX preview."
                               wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="SQLite-only upload. No OCR, no external AI, no legacy text-file writeback." styleClass="status-info metric-value compact-metric-value" />
                            <Label fx:id="patientFilterChip" text="" managed="false" visible="false" styleClass="status-success success-value" />
                            <Button fx:id="clearPatientFilterButton" text="Clear Patient Filter" onAction="#clearPatientFilter"
                                    managed="false" visible="false" styleClass="transparent-pane secondary-button" />
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />
                                <TextField fx:id="searchField" promptText="Patient ID, patient name, original filename, uploaded by" HBox.hgrow="ALWAYS" styleClass="control-input" />
                                <Label text="Category" styleClass="field-label" />
                                <ComboBox fx:id="categoryFilter" prefWidth="180.0" styleClass="control-input" />
                                <Label text="Date" styleClass="field-label" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="135.0" styleClass="control-input" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Uploaded By" styleClass="field-label" />
                                <TextField fx:id="uploadedByFilter" promptText="Username" prefWidth="220.0" styleClass="control-input" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="uploadButton" text="Upload Medical File" onAction="#uploadFile" styleClass="primary-button" />
                                <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />
                                <Button text="Refresh" onAction="#loadFiles" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <SplitPane dividerPositions="0.62" prefHeight="630.0" styleClass="transparent-pane">
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Uploaded Files" styleClass="section-title" />
                                <TableView fx:id="filesTable" VBox.vgrow="ALWAYS" styleClass="dialog-card">
                                    <columns>
                                        <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="110.0" />
                                        <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="165.0" />
                                        <TableColumn fx:id="originalNameColumn" text="Original Name" prefWidth="210.0" />
                                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140.0" />
                                        <TableColumn fx:id="uploadedByColumn" text="Uploaded By" prefWidth="130.0" />
                                        <TableColumn fx:id="uploadedAtColumn" text="Uploaded At" prefWidth="160.0" />
                                        <TableColumn fx:id="fileSizeColumn" text="Size" prefWidth="100.0" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="12.0" styleClass="panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="detailTitleLabel" text="Select a file" styleClass="detail-value" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="copySummaryButton" text="Copy Summary" onAction="#copySummary" disable="true" styleClass="secondary-button" />
                                    <Button fx:id="openFileButton" text="Open File" onAction="#openSelectedFile" disable="true" styleClass="secondary-button" />
                                    <Button fx:id="aiSummaryButton" text="Generate AI Summary Note" onAction="#generateAiSummaryNote" disable="true" styleClass="secondary-button" />
                                </HBox>

                                <Label text="File ID" styleClass="metric-label" />
                                <Label fx:id="fileIdLabel" text="-" wrapText="true" styleClass="muted-text" />

                                <Label text="Patient" styleClass="metric-label" />
                                <Label fx:id="patientLabel" text="-" wrapText="true" styleClass="muted-text" />

                                <Label text="Original Name" styleClass="metric-label" />
                                <Label fx:id="originalNameLabel" text="-" wrapText="true" styleClass="muted-text" />

                                <Label text="Stored Path" styleClass="metric-label" />
                                <Label fx:id="storedPathLabel" text="-" wrapText="true" styleClass="muted-text" />

                                <HBox spacing="16.0">
                                    <VBox spacing="4.0">
                                        <Label text="Category" styleClass="metric-label" />
                                        <Label fx:id="categoryLabel" text="-" styleClass="body-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded By" styleClass="metric-label" />
                                        <Label fx:id="uploadedByLabel" text="-" styleClass="body-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded At" styleClass="metric-label" />
                                        <Label fx:id="uploadedAtLabel" text="-" styleClass="body-text" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Size" styleClass="metric-label" />
                                        <Label fx:id="fileSizeLabel" text="-" styleClass="body-text" />
                                    </VBox>
                                </HBox>

                                <Label text="Extracted Summary" styleClass="metric-label" />
                                <TextArea fx:id="summaryArea" editable="false" wrapText="true" prefRowCount="6" styleClass="control-input" />

                                <Label text="Notes" styleClass="metric-label" />
                                <TextArea fx:id="notesArea" editable="false" wrapText="true" prefRowCount="3" styleClass="control-input" />

                                <HBox spacing="8.0">
                                    <Label text="Safe Preview" styleClass="metric-label" />
                                    <Label fx:id="previewTypeLabel" text="-" styleClass="status-info metric-value compact-metric-value" />
                                </HBox>

                                <ImageView fx:id="previewImageView" fitHeight="280.0" fitWidth="500.0" preserveRatio="true" smooth="true" managed="false" visible="false" />

                                <TextArea fx:id="previewArea" editable="false" wrapText="true" prefRowCount="7"
                                          text="Select a medical file to load a safe local preview." styleClass="control-input" />
                            </VBox>
                        </SplitPane>

                        <Label fx:id="statusLabel" text="Medical files not loaded yet." wrapText="true" styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
