<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1180.0"
        prefHeight="740.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicalFilesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label text="Medical Files"
                       style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="SQLite upload and local basic analysis preview"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 18; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0"
                          style="-fx-background-color: #FFF3E0; -fx-background-radius: 18; -fx-padding: 20; -fx-border-color: #FFCC80; -fx-border-radius: 18;">
                        <Label text="Access denied"
                               style="-fx-text-fill: #E65100; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Medical Files is available to Admin, Doctor, and Nurse roles in this JavaFX preview."
                               wrapText="true"
                               style="-fx-text-fill: #5D4037; -fx-font-size: 14px;" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="SQLite-only upload. No OCR, no external AI, no legacy text-file writeback."
                                   style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 7 14; -fx-font-weight: bold;" />
                            <Label fx:id="patientFilterChip" text="" managed="false" visible="false"
                                   style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-background-radius: 18; -fx-padding: 7 14; -fx-font-weight: bold;" />
                            <Button fx:id="clearPatientFilterButton" text="Clear Patient Filter" onAction="#clearPatientFilter"
                                    managed="false" visible="false"
                                    style="-fx-background-color: transparent; -fx-text-fill: #607D8B; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>

                        <VBox spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <TextField fx:id="searchField" promptText="Patient ID, patient name, original filename, uploaded by" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC; -fx-padding: 10 12; -fx-font-size: 14px;" />
                                <Label text="Category" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="categoryFilter" prefWidth="180.0"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />
                                <Label text="Date" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="135.0"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Uploaded By" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <TextField fx:id="uploadedByFilter" promptText="Username" prefWidth="220.0"
                                           style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC; -fx-padding: 10 12; -fx-font-size: 14px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="uploadButton" text="Upload Medical File" onAction="#uploadFile"
                                        style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="Clear Filters" onAction="#clearFilters"
                                        style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="Refresh" onAction="#loadFiles"
                                        style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <SplitPane dividerPositions="0.62" prefHeight="630.0" style="-fx-background-color: transparent;">
                            <VBox spacing="10.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Uploaded Files"
                                       style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <TableView fx:id="filesTable" VBox.vgrow="ALWAYS"
                                           style="-fx-background-color: white; -fx-border-color: #E0E7EF; -fx-border-radius: 14; -fx-background-radius: 14;">
                                    <columns>
                                        <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="110.0" />
                                        <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="165.0" />
                                        <TableColumn fx:id="originalNameColumn" text="Original Name" prefWidth="210.0" />
                                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140.0" />
                                        <TableColumn fx:id="uploadedByColumn" text="Uploaded By" prefWidth="130.0" />
                                        <TableColumn fx:id="uploadedAtColumn" text="Uploaded At" prefWidth="160.0" />
                                        <TableColumn fx:id="fileSizeColumn" text="Size" prefWidth="100.0" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="12.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="detailTitleLabel" text="Select a file"
                                           style="-fx-text-fill: #0D47A1; -fx-font-size: 20px; -fx-font-weight: bold;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="copySummaryButton" text="Copy Summary" onAction="#copySummary" disable="true"
                                            style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 8 14; -fx-cursor: hand;" />
                                    <Button fx:id="openFileButton" text="Open File" onAction="#openSelectedFile" disable="true"
                                            style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 8 14; -fx-cursor: hand;" />
                                    <Button fx:id="aiSummaryButton" text="Generate AI Summary Note" onAction="#generateAiSummaryNote" disable="true"
                                            style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 8 14; -fx-cursor: hand;" />
                                </HBox>

                                <Label text="File ID" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="fileIdLabel" text="-" wrapText="true" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />

                                <Label text="Patient" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="patientLabel" text="-" wrapText="true" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />

                                <Label text="Original Name" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="originalNameLabel" text="-" wrapText="true" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />

                                <Label text="Stored Path" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="storedPathLabel" text="-" wrapText="true" style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />

                                <HBox spacing="16.0">
                                    <VBox spacing="4.0">
                                        <Label text="Category" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                        <Label fx:id="categoryLabel" text="-" style="-fx-text-fill: #263238; -fx-font-weight: bold;" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded By" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                        <Label fx:id="uploadedByLabel" text="-" style="-fx-text-fill: #263238; -fx-font-weight: bold;" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Uploaded At" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                        <Label fx:id="uploadedAtLabel" text="-" style="-fx-text-fill: #263238; -fx-font-weight: bold;" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <Label text="Size" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                        <Label fx:id="fileSizeLabel" text="-" style="-fx-text-fill: #263238; -fx-font-weight: bold;" />
                                    </VBox>
                                </HBox>

                                <Label text="Extracted Summary" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <TextArea fx:id="summaryArea" editable="false" wrapText="true" prefRowCount="6"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E0E7EF; -fx-font-size: 13px;" />

                                <Label text="Notes" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <TextArea fx:id="notesArea" editable="false" wrapText="true" prefRowCount="3"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E0E7EF; -fx-font-size: 13px;" />

                                <HBox spacing="8.0">
                                    <Label text="Safe Preview" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    <Label fx:id="previewTypeLabel" text="-"
                                           style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 16; -fx-padding: 5 12; -fx-font-weight: bold;" />
                                </HBox>

                                <ImageView fx:id="previewImageView" fitHeight="280.0" fitWidth="500.0" preserveRatio="true" smooth="true" managed="false" visible="false" />

                                <TextArea fx:id="previewArea" editable="false" wrapText="true" prefRowCount="7"
                                          text="Select a medical file to load a safe local preview."
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E0E7EF; -fx-font-size: 13px;" />
                            </VBox>
                        </SplitPane>

                        <Label fx:id="statusLabel" text="Medical files not loaded yet." wrapText="true"
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>