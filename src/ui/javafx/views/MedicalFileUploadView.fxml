<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="760.0"
        style="-fx-background-color: white;
               -fx-background-radius: 20;
               -fx-padding: 22;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicalFileUploadController">

    <VBox spacing="4.0">
        <Label
                text="Upload Medical File"
                style="-fx-text-fill: #0D47A1;
                       -fx-font-size: 22px;
                       -fx-font-weight: bold;" />

        <Label
                text="SQLite-only upload. TXT/CSV/PDF text extraction is local; image OCR is not implemented."
                wrapText="true"
                style="-fx-text-fill: #607D8B;
                       -fx-font-size: 13px;" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label
                    text="Patient ID"
                    style="-fx-text-fill: #263238;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;" />

            <TextField
                    fx:id="patientIdField"
                    promptText="PAT-001"
                    style="-fx-background-color: #FAFCFD;
                           -fx-background-radius: 13;
                           -fx-border-radius: 13;
                           -fx-border-color: #CFD8DC;
                           -fx-padding: 10 12;
                           -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label
                    text="Category"
                    style="-fx-text-fill: #263238;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;" />

            <ComboBox
                    fx:id="categoryBox"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FAFCFD;
                           -fx-background-radius: 13;
                           -fx-border-radius: 13;
                           -fx-border-color: #CFD8DC;" />
        </VBox>

        <VBox spacing="6.0"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              GridPane.rowIndex="1">

            <Label
                    text="Selected File"
                    style="-fx-text-fill: #263238;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;" />

            <HBox spacing="8.0">
                <TextField
                        fx:id="filePathField"
                        promptText="Choose txt, csv, pdf, png, jpg, or jpeg file"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #FAFCFD;
                               -fx-background-radius: 13;
                               -fx-border-radius: 13;
                               -fx-border-color: #CFD8DC;
                               -fx-padding: 10 12;
                               -fx-font-size: 14px;" />

                <Button
                        text="Browse"
                        onAction="#browseFile"
                        style="-fx-background-color: #EEF5FF;
                               -fx-text-fill: #0D47A1;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 18;
                               -fx-cursor: hand;" />
            </HBox>
        </VBox>

        <VBox spacing="6.0"
              GridPane.columnIndex="0"
              GridPane.columnSpan="2"
              GridPane.rowIndex="2">

            <Label
                    text="Notes"
                    style="-fx-text-fill: #263238;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;" />

            <TextArea
                    fx:id="notesArea"
                    prefRowCount="4"
                    wrapText="true"
                    promptText="Optional upload notes"
                    style="-fx-background-color: #FAFCFD;
                           -fx-background-radius: 13;
                           -fx-border-radius: 13;
                           -fx-border-color: #CFD8DC;
                           -fx-padding: 8;
                           -fx-font-size: 14px;" />
        </VBox>
    </GridPane>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label
                text="Uploaded By"
                style="-fx-text-fill: #78909C;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;" />

        <Label
                fx:id="uploadedByLabel"
                text="-"
                style="-fx-background-color: #E3F2FD;
                       -fx-text-fill: #0D47A1;
                       -fx-background-radius: 16;
                       -fx-padding: 5 12;
                       -fx-font-weight: bold;" />
    </HBox>

    <Label
            fx:id="statusLabel"
            text="-"
            wrapText="true"
            style="-fx-background-color: #E0F2F1;
                   -fx-text-fill: #00695C;
                   -fx-background-radius: 18;
                   -fx-padding: 8 14;
                   -fx-font-size: 13px;" />
</VBox>