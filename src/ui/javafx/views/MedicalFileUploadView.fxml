<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="panel-card" prefWidth="720.0" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.MedicalFileUploadController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <Label text="Upload Medical File" styleClass="section-title" />
    <Label text="SQLite-only upload. TXT/CSV/PDF text extraction is local; image OCR is not implemented." wrapText="true" styleClass="muted-text" />
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />
            <TextField fx:id="patientIdField" promptText="PAT-001" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Category" styleClass="field-label" />
            <ComboBox fx:id="categoryBox" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
            <Label text="Selected File" styleClass="field-label" />
            <HBox spacing="8.0">
                <TextField fx:id="filePathField" promptText="Choose txt, csv, pdf, png, jpg, or jpeg file" HBox.hgrow="ALWAYS" />
                <Button text="Browse" onAction="#browseFile" styleClass="secondary-button" />
            </HBox>
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
            <Label text="Notes" styleClass="field-label" />
            <TextArea fx:id="notesArea" prefRowCount="4" wrapText="true" promptText="Optional upload notes" />
        </VBox>
    </GridPane>
    <HBox spacing="8.0">
        <Label text="Uploaded By" styleClass="field-label" />
        <Label fx:id="uploadedByLabel" text="-" styleClass="muted-text" />
    </HBox>
    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-info" />
</VBox>
