<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefWidth="1100.0"
        prefHeight="700.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.AiRecommendationsController" styleClass="content-page">

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="16.0" styleClass="top-bar compact-top-bar">

            <VBox spacing="4.0">
                <Label
                        text="AI Recommendations" styleClass="screen-title" />

                <Label
                        text="Rule-based decision support only. Not a medical diagnosis." styleClass="muted-text" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button
                    text="Dashboard"
                    onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane
                fitToWidth="true" styleClass="scroll-clear">

            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                    </padding>

                    <VBox
                            fx:id="accessDeniedPane"
                            managed="false"
                            visible="false"
                            spacing="10.0" styleClass="warning-panel">

                        <Label
                                text="Access denied" styleClass="warning-value" />

                        <Label
                                text="AI Recommendations are available to Admin, Doctor, and Nurse roles for authorized hospital roles."
                                wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="aiContentPane" spacing="18.0">

                        <VBox
                                spacing="8.0" styleClass="panel-card">

                            <Label
                                    text="Clinical Decision Support Notice" styleClass="metric-value compact-metric-value" />

                            <Label
                                    text="Rule-based decision support only. Not a medical diagnosis. Clinical staff must verify patient condition and follow hospital policy."
                                    wrapText="true" styleClass="body-text" />
                        </VBox>

                        <VBox
                                spacing="12.0" styleClass="panel-card">

                            <HBox alignment="CENTER_LEFT" spacing="12.0">

                                <Label
                                        text="Section" styleClass="field-label" />

                                <ComboBox
                                        fx:id="sectionFilter"
                                        prefWidth="180.0" styleClass="control-input" />

                                <Label
                                        text="Risk Level" styleClass="field-label" />

                                <ComboBox
                                        fx:id="riskLevelFilter"
                                        prefWidth="150.0" styleClass="control-input" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button
                                        text="Open Selected Patient"
                                        onAction="#openSelectedPatient" styleClass="primary-button" />

                                <Button
                                        text="Clear Filters"
                                        onAction="#clearFilters" styleClass="secondary-button" />

                                <Button
                                        text="Refresh"
                                        onAction="#loadRecommendations" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <VBox
                                spacing="10.0" styleClass="panel-card">

                            <Label
                                    text="Patient Risk Recommendations" styleClass="section-title" />

                            <TableView
                                    fx:id="recommendationTable"
                                    prefHeight="500.0" styleClass="dialog-card">

                                <columns>
                                    <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="110.0" />
                                    <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="170.0" />
                                    <TableColumn fx:id="sectionColumn" text="Section" prefWidth="120.0" />
                                    <TableColumn fx:id="riskScoreColumn" text="Risk Score" prefWidth="105.0" />
                                    <TableColumn fx:id="riskLevelColumn" text="Risk Level" prefWidth="110.0" />
                                    <TableColumn fx:id="recommendationColumn" text="Latest Recommendation" prefWidth="400.0" />
                                    <TableColumn fx:id="reasonsColumn" text="Reason Indicators" prefWidth="330.0" />
                                    <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="160.0" />
                                </columns>
                            </TableView>
                        </VBox>

                        <Label
                                fx:id="statusLabel"
                                text="AI recommendations not loaded yet."
                                wrapText="true" styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
