<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="950.0"
        prefHeight="620.0"
        style="-fx-background-color: linear-gradient(to bottom right, #0D47A1, #1E88E5, #EAF4F8);"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.LoginController">

    <center>
        <StackPane>
            <HBox
                    maxWidth="780.0"
                    maxHeight="500.0"
                    style="-fx-background-color: white;
                           -fx-background-radius: 26;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 30, 0, 0, 10);">

                <VBox
                        prefWidth="310.0"
                        alignment="CENTER"
                        spacing="14.0"
                        style="-fx-background-color: linear-gradient(to bottom, #0D47A1, #08306B);
                               -fx-background-radius: 26 0 0 26;
                               -fx-padding: 34;">

                    <Label
                            text="SPMS"
                            style="-fx-text-fill: white;
                                   -fx-font-size: 42px;
                                   -fx-font-weight: bold;" />

                    <Label
                            text="Smart Patient Monitoring System"
                            wrapText="true"
                            textAlignment="CENTER"
                            alignment="CENTER"
                            style="-fx-text-fill: #BBDEFB;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;" />

                    <Label
                            text="Secure hospital dashboard for patients, alerts, devices, files, and clinical notes."
                            wrapText="true"
                            textAlignment="CENTER"
                            alignment="CENTER"
                            style="-fx-text-fill: #E3F2FD;
                                   -fx-font-size: 13px;" />
                </VBox>

                <VBox
                        prefWidth="470.0"
                        alignment="CENTER"
                        spacing="18.0"
                        style="-fx-padding: 42 46;">

                    <VBox alignment="CENTER_LEFT" spacing="5.0">
                        <Label
                                text="Welcome Back"
                                style="-fx-text-fill: #0D47A1;
                                       -fx-font-size: 28px;
                                       -fx-font-weight: bold;" />

                        <Label
                                text="Login to continue to the medical workspace"
                                style="-fx-text-fill: #607D8B;
                                       -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="10.0" fillWidth="true">
                        <Label
                                text="Username"
                                style="-fx-text-fill: #263238;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;" />

                        <TextField
                                fx:id="usernameField"
                                promptText="doctor, nurse, admin..."
                                style="-fx-background-radius: 14;
                                       -fx-border-radius: 14;
                                       -fx-border-color: #CFD8DC;
                                       -fx-border-width: 1;
                                       -fx-padding: 12 14;
                                       -fx-font-size: 14px;
                                       -fx-background-color: #FAFCFD;" />

                        <Label
                                text="Password"
                                style="-fx-text-fill: #263238;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;" />

                        <PasswordField
                                fx:id="passwordField"
                                onAction="#handleLogin"
                                promptText="Password"
                                style="-fx-background-radius: 14;
                                       -fx-border-radius: 14;
                                       -fx-border-color: #CFD8DC;
                                       -fx-border-width: 1;
                                       -fx-padding: 12 14;
                                       -fx-font-size: 14px;
                                       -fx-background-color: #FAFCFD;" />
                    </VBox>

                    <HBox spacing="12.0" alignment="CENTER">
                        <Button
                                maxWidth="Infinity"
                                onAction="#handleLogin"
                                text="Login"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #1E88E5;
                                       -fx-text-fill: white;
                                       -fx-font-size: 15px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 15;
                                       -fx-padding: 12 28;
                                       -fx-cursor: hand;" />

                        <Button
                                onAction="#handleClear"
                                text="Clear"
                                style="-fx-background-color: #EEF5FF;
                                       -fx-text-fill: #0D47A1;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 14;
                                       -fx-padding: 12 20;
                                       -fx-cursor: hand;" />
                    </HBox>

                    <Label
                            fx:id="statusLabel"
                            wrapText="true"
                            alignment="CENTER"
                            textAlignment="CENTER"
                            style="-fx-text-fill: #D32F2F;
                                   -fx-font-size: 13px;" />

                    <Label
                            fx:id="databaseStatusLabel"
                            wrapText="true"
                            alignment="CENTER"
                            textAlignment="CENTER"
                            style="-fx-background-color: #E3F2FD;
                                   -fx-text-fill: #0D47A1;
                                   -fx-background-radius: 20;
                                   -fx-padding: 7 14;
                                   -fx-font-size: 12px;" />

                </VBox>
            </HBox>
        </StackPane>
    </center>
</BorderPane>