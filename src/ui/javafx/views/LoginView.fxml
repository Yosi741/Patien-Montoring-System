<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane
        prefWidth="1180.0"
        prefHeight="760.0"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.LoginController"
        styleClass="login-page">

    <center>
        <StackPane styleClass="login-stage">
            <HBox maxWidth="1080.0" maxHeight="610.0" styleClass="login-shell-card">

                <VBox
                        prefWidth="455.0"
                        alignment="CENTER"
                        spacing="24.0"
                        styleClass="login-brand-panel">

                    <VBox alignment="CENTER" spacing="18.0">
                        <StackPane styleClass="login-logo-mark">
                            <Label text="+" styleClass="login-logo-cross" />
                            <Polyline points="-42,2,-18,2,-8,-22,8,26,20,2,42,2"
                                      styleClass="login-logo-pulse" />
                        </StackPane>

                        <VBox alignment="CENTER" spacing="6.0">
                            <Label text="SPMS" styleClass="login-brand-title" />
                            <Label text="Smart Patient Monitoring System"
                                   textAlignment="CENTER"
                                   alignment="CENTER"
                                   styleClass="login-brand-subtitle" />
                        </VBox>
                    </VBox>

                    <Region prefHeight="8.0" />

                    <VBox alignment="CENTER" spacing="12.0" maxWidth="300.0">
                        <Label text="Clinical workspace for patient monitoring"
                               wrapText="true"
                               textAlignment="CENTER"
                               alignment="CENTER"
                               styleClass="login-brand-message" />

                        <Label text="Patients | Alerts | Files | Clinical records"
                               wrapText="true"
                               textAlignment="CENTER"
                               alignment="CENTER"
                               styleClass="login-brand-helper" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox alignment="CENTER" spacing="12.0" styleClass="login-security-strip">
                        <Label text="OK" styleClass="login-security-icon" />
                        <VBox spacing="2.0">
                            <Label text="Protected clinical access" styleClass="login-security-title" />
                            <Label text="Private | Reliable | Local hospital system" styleClass="login-security-text" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox
                        prefWidth="625.0"
                        alignment="CENTER"
                        spacing="28.0"
                        styleClass="login-form-panel">

                    <VBox alignment="CENTER" spacing="10.0">
                        <StackPane styleClass="login-user-icon-wrap">
                            <Label text="Staff" styleClass="login-user-icon" />
                        </StackPane>

                        <Label text="Welcome Back" styleClass="login-title" />
                        <Label text="Login to continue to your medical workspace"
                               wrapText="true"
                               textAlignment="CENTER"
                               alignment="CENTER"
                               styleClass="login-subtitle" />
                    </VBox>

                    <VBox spacing="18.0" fillWidth="true" maxWidth="470.0">
                        <VBox spacing="8.0">
                            <Label text="Username" styleClass="login-field-label" />

                            <TextField
                                    fx:id="usernameField"
                                    promptText="Enter your username"
                                    styleClass="login-input" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Password" styleClass="login-field-label" />

                            <PasswordField
                                    fx:id="passwordField"
                                    onAction="#handleLogin"
                                    promptText="Enter your password"
                                    styleClass="login-input" />
                        </VBox>
                    </VBox>

                    <VBox spacing="14.0" maxWidth="470.0" fillWidth="true">
                        <Button
                                maxWidth="Infinity"
                                onAction="#handleLogin"
                                text="Login"
                                styleClass="login-primary-button" />

                        <HBox alignment="CENTER" spacing="14.0">
                            <Separator HBox.hgrow="ALWAYS" />
                            <Label text="or" styleClass="login-divider-text" />
                            <Separator HBox.hgrow="ALWAYS" />
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0">
                            <Button
                                    onAction="#forgotPassword"
                                    text="Forgot Password?"
                                    styleClass="login-link-button" />

                            <Button
                                    onAction="#handleClear"
                                    text="Clear"
                                    styleClass="login-clear-button" />
                        </HBox>
                    </VBox>

                    <Label
                            fx:id="statusLabel"
                            wrapText="true"
                            alignment="CENTER"
                            textAlignment="CENTER"
                            maxWidth="470.0"
                            styleClass="login-status-text" />
                </VBox>
            </HBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="login-footer">
            <Label text="OK" styleClass="login-footer-icon" />
            <Label text="System Status: Online" styleClass="login-footer-strong" />
            <Label text="|" styleClass="login-footer-muted" />
            <Label text="All systems operational" styleClass="login-footer-muted" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Version 1.0.0" styleClass="login-footer-muted" />
        </HBox>
    </bottom>
</BorderPane>
