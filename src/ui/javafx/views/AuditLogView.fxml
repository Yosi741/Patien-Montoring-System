<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1050.0"
        prefHeight="680.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.AuditLogController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Audit Logs" styleClass="screen-title" />
                <Label text="Read-only local database admin audit viewer" styleClass="muted-text" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <VBox fx:id="accessDeniedPane"
                  managed="false"
                  visible="false"
                  spacing="10.0" styleClass="warning-panel">

                <Label text="Access denied" styleClass="warning-value" />

                <Label text="Audit logs are visible only for Admin users for authorized hospital roles."
                       wrapText="true" styleClass="body-text" />
            </VBox>

            <VBox fx:id="auditContentPane" spacing="16.0">

                <VBox spacing="12.0" styleClass="panel-card">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Search" styleClass="field-label" />

                        <TextField fx:id="searchField" promptText="Username or action" HBox.hgrow="ALWAYS" styleClass="control-input" />

                        <Label text="Date Range" styleClass="field-label" />

                        <ComboBox fx:id="dateRangeFilter" prefWidth="150.0" styleClass="control-input" />

                        <Label text="Action Type" styleClass="field-label" />

                        <ComboBox fx:id="actionTypeFilter" prefWidth="140.0" styleClass="control-input" />

                        <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />

                        <Button text="Refresh" onAction="#loadLogs" styleClass="secondary-button" />
                    </HBox>
                </VBox>

                <VBox spacing="10.0"
                      VBox.vgrow="ALWAYS" styleClass="panel-card">

                    <Label text="System Activity History" styleClass="section-title" />

                    <TableView fx:id="auditTable"
                               VBox.vgrow="ALWAYS" styleClass="dialog-card">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0" />
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180.0" />
                            <TableColumn fx:id="actionColumn" text="Action" prefWidth="540.0" />
                            <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="200.0" />
                        </columns>
                    </TableView>
                </VBox>

                <Label fx:id="statusLabel"
                       text="Audit logs loaded: 0" styleClass="status-info metric-value compact-metric-value" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
