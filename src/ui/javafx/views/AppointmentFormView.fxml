<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        spacing="16.0"
        prefWidth="760.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.AppointmentFormController" styleClass="panel-card">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="4.0">
            <Label
                    fx:id="titleLabel"
                    text="Appointment" styleClass="screen-title" />

            <Label
                    text="Local database appointment scheduling. No external calendar integration in this phase."
                    wrapText="true" styleClass="muted-text" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient No." styleClass="field-label" />
            <TextField fx:id="patientIdField" promptText="PAT-001" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Title" styleClass="field-label" />
            <TextField fx:id="appointmentTitleField" promptText="Cardiology follow-up" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Type" styleClass="field-label" />
            <ComboBox fx:id="typeBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Status" styleClass="field-label" />
            <ComboBox fx:id="statusBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Start Time" styleClass="field-label" />
            <TextField fx:id="startTimeField" promptText="dd-MM-yyyy HH:mm:ss" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="End Time" styleClass="field-label" />
            <TextField fx:id="endTimeField" promptText="dd-MM-yyyy HH:mm:ss" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Location" styleClass="field-label" />
            <TextField fx:id="locationField" promptText="Clinic / OR / Lab" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Assigned Staff" styleClass="field-label" />
            <TextField fx:id="assignedStaffField" promptText="Doctor or nurse username" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Notes" styleClass="field-label" />
            <TextArea fx:id="notesArea" prefRowCount="4" wrapText="true" promptText="Optional scheduling notes" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label
            fx:id="statusLabel"
            text="-"
            wrapText="true" styleClass="status-info metric-value compact-metric-value" />
</VBox>
