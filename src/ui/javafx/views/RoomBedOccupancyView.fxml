<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-page sections-rooms-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.RoomBedOccupancyController">

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0" styleClass="sections-rooms-page">
                    <padding>
                        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="page-header-card">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="screen-title" text="Sections / Rooms" />
                            <Label styleClass="muted-text" text="Manage hospital sections, rooms, capacity, and room status." wrapText="true" />
                        </VBox>
                        <Button onAction="#showDashboard" styleClass="secondary-button" text="Back to Dashboard" />
                    </HBox>

                    <VBox fx:id="accessDeniedPane" managed="false" spacing="10.0" styleClass="warning-panel" visible="false">
                        <Label styleClass="warning-value" text="Access denied" />
                        <Label styleClass="body-text" text="Sections / Rooms is available to Admin, Doctor, and Nurse roles." wrapText="true" />
                    </VBox>

                    <VBox fx:id="occupancyContentPane" spacing="18.0">
                        <GridPane hgap="14.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>

                            <VBox maxWidth="Infinity" spacing="7.0" styleClass="summary-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="metric-label" text="Total Sections" />
                                <Label fx:id="totalSectionsLabel" styleClass="metric-value compact-metric-value" text="0" />
                            </VBox>

                            <VBox maxWidth="Infinity" spacing="7.0" styleClass="summary-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="metric-label" text="Total Rooms" />
                                <Label fx:id="totalRoomsLabel" styleClass="accent-value" text="0" />
                            </VBox>

                            <VBox maxWidth="Infinity" spacing="7.0" styleClass="summary-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label styleClass="metric-label" text="Occupied Rooms" />
                                <Label fx:id="occupiedRoomsLabel" styleClass="success-value" text="0" />
                            </VBox>

                            <VBox maxWidth="Infinity" spacing="7.0" styleClass="summary-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label styleClass="metric-label" text="Available Beds" />
                                <Label fx:id="availableCapacityLabel" styleClass="accent-value" text="0" />
                            </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>

                        <HBox managed="false" spacing="18.0" visible="false">
                            <VBox spacing="12.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="section-title" text="Active Patients By Section" />
                                <VBox fx:id="activePatientsBySectionBox" spacing="8.0" />
                            </VBox>

                            <VBox spacing="12.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="section-title" text="Critical / Emergency By Section" />
                                <VBox fx:id="criticalPatientsBySectionBox" spacing="8.0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="14.0" styleClass="management-panel">
                            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="panel-header">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="section-title" text="Sections" />
                                    <Label styleClass="muted-text" text="Manage hospital departments used by users, patients, and rooms." wrapText="true" />
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="action-toolbar">
                                    <Button fx:id="addSectionButton" onAction="#addSection" styleClass="secondary-button" text="Add Section" />
                                    <Button fx:id="editSectionButton" onAction="#editSection" styleClass="secondary-button" text="Edit Section" />
                                    <Button fx:id="deactivateSectionButton" onAction="#deactivateSection" styleClass="danger-button" text="Deactivate Section" />
                                </HBox>
                            </HBox>

                                                        <TableView fx:id="sectionTable" prefHeight="210.0" styleClass="dialog-card sections-table clinical-table">
                                <columns>
                                    <TableColumn fx:id="sectionRowNumberColumn" prefWidth="55.0" sortable="false" text="#" />
                                    <TableColumn fx:id="sectionNameColumn" prefWidth="210.0" text="Section" />
                                    <TableColumn fx:id="sectionStatusColumn" prefWidth="130.0" text="Status" />
                                    <TableColumn fx:id="sectionUpdatedColumn" prefWidth="190.0" text="Updated" />
                                    <TableColumn fx:id="sectionNotesColumn" prefWidth="560.0" text="Notes" />
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="14.0" styleClass="management-panel">
                            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="panel-header">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="section-title" text="Rooms &amp; Assignments" />
                                    <Label styleClass="muted-text" text="Manage rooms, capacity, and assigned patients." wrapText="true" />
                                </VBox>
                            </HBox>

                            <GridPane hgap="12.0" styleClass="filter-toolbar" vgap="8.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="22.0" />
                                    <ColumnConstraints percentWidth="34.0" />
                                    <ColumnConstraints percentWidth="22.0" />
                                    <ColumnConstraints percentWidth="22.0" />
                                </columnConstraints>

                                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Section" />
                                    <ComboBox fx:id="sectionFilter" maxWidth="Infinity" styleClass="control-input" />
                                </VBox>

                                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Room Search" />
                                    <TextField fx:id="roomSearchField" promptText="Room number" styleClass="control-input" />
                                </VBox>

                                <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Status" />
                                    <ComboBox fx:id="statusFilter" maxWidth="Infinity" styleClass="control-input" />
                                </VBox>

                                <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="Priority" />
                                    <ComboBox fx:id="priorityFilter" maxWidth="Infinity" styleClass="control-input" />
                                </VBox>
                        <rowConstraints>
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>

                            <VBox spacing="8.0" styleClass="actions-card compact-actions-card">
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="button-group">
                                    <Button fx:id="editRoomButton" onAction="#editRoom" styleClass="secondary-button" text="Manage Room" />
                                    <Button fx:id="deactivateRoomButton" onAction="#deactivateRoom" styleClass="danger-button" text="Deactivate Room" />
                                    <Button onAction="#clearFilters" styleClass="secondary-button" text="Clear Filters" />
                                    <Button onAction="#loadOccupancy" styleClass="secondary-button" text="Refresh" />
                                </HBox>
                            </VBox>

                            <TableView fx:id="roomTable" prefHeight="430.0" styleClass="dialog-card rooms-table clinical-table">
                                <columns>
                                    <TableColumn fx:id="roomRowNumberColumn" prefWidth="55.0" sortable="false" text="#" />
                                    <TableColumn fx:id="sectionColumn" prefWidth="150.0" text="Section" />
                                    <TableColumn fx:id="roomColumn" prefWidth="120.0" text="Room" />
                                    <TableColumn fx:id="roomStatusColumn" prefWidth="120.0" text="Status" />
                                    <TableColumn fx:id="capacityColumn" prefWidth="90.0" text="Beds" />
                                    <TableColumn fx:id="occupiedColumn" prefWidth="90.0" text="Occupied" />
                                    <TableColumn fx:id="availableColumn" prefWidth="90.0" text="Available" />
                                    <TableColumn fx:id="patientsColumn" prefWidth="540.0" text="Patients" />
                                </columns>
                            </TableView>

                            <VBox spacing="6.0" styleClass="panel-footer">
                                <Label styleClass="muted-text" text="Patient names are shown for occupancy context. Move patients from Patient Board or Patient File." wrapText="true" />
                                <Label fx:id="occupancySourceLabel" styleClass="status-info warning-value" text="Room occupancy source not loaded yet." wrapText="true" />
                                <Label fx:id="statusLabel" styleClass="status-info metric-value compact-metric-value" text="Sections / Rooms not loaded yet." wrapText="true" />
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
