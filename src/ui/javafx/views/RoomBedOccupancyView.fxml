<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="760.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.RoomBedOccupancyController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label text="Room / Bed Occupancy"
                       style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Read-only SQLite section, room, bed, and patient assignment overview"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 18; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0"
                          style="-fx-background-color: #FFF3E0; -fx-background-radius: 18; -fx-padding: 20; -fx-border-color: #FFCC80; -fx-border-radius: 18;">
                        <Label text="Access denied"
                               style="-fx-text-fill: #E65100; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Room/Bed Occupancy is available to Admin, Doctor, and Nurse roles in this JavaFX preview."
                               wrapText="true"
                               style="-fx-text-fill: #5D4037; -fx-font-size: 14px;" />
                    </VBox>

                    <VBox fx:id="occupancyContentPane" spacing="18.0">

                        <GridPane hgap="14.0" vgap="14.0">
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Total Rooms" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="totalRoomsLabel" text="0" style="-fx-text-fill: #0D47A1; -fx-font-size: 30px; -fx-font-weight: bold;" />
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Occupied Rooms" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="occupiedRoomsLabel" text="0" style="-fx-text-fill: #00695C; -fx-font-size: 30px; -fx-font-weight: bold;" />
                            </VBox>

                            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="6.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Occupied Beds" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="occupiedBedsLabel" text="0" style="-fx-text-fill: #E65100; -fx-font-size: 30px; -fx-font-weight: bold;" />
                            </VBox>

                            <VBox GridPane.columnIndex="3" GridPane.rowIndex="0" spacing="6.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 230; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Available Capacity" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="availableCapacityLabel" text="0" style="-fx-text-fill: #6A1B9A; -fx-font-size: 30px; -fx-font-weight: bold;" />
                            </VBox>
                        </GridPane>

                        <HBox spacing="18.0">
                            <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Active Patients By Section"
                                       style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <VBox fx:id="activePatientsBySectionBox" spacing="8.0" />
                            </VBox>

                            <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Critical / Emergency By Section"
                                       style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <VBox fx:id="criticalPatientsBySectionBox" spacing="8.0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Section" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="sectionFilter" prefWidth="165.0"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                                <Label text="Room" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <TextField fx:id="roomSearchField" promptText="Room number" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC; -fx-padding: 10 12; -fx-font-size: 14px;" />

                                <Label text="Status" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="statusFilter" prefWidth="140.0"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />

                                <Label text="Priority" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="priorityFilter" prefWidth="140.0"
                                          style="-fx-background-color: #FAFCFD; -fx-background-radius: 13; -fx-border-radius: 13; -fx-border-color: #CFD8DC;" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <Button text="Open Selected Patient" onAction="#openSelectedPatient"
                                        style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                                <Button text="Clear Filters" onAction="#clearFilters"
                                        style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />

                                <Button text="Refresh" onAction="#loadOccupancy"
                                        style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label text="Rooms / Beds"
                                       style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Double-click an occupied row to open the highest-priority assigned patient"
                                       style="-fx-text-fill: #607D8B; -fx-font-size: 12px;" />
                            </HBox>

                            <TableView fx:id="roomTable" prefHeight="430.0"
                                       style="-fx-background-color: white; -fx-border-color: #E0E7EF; -fx-border-radius: 14; -fx-background-radius: 14;">
                                <columns>
                                    <TableColumn fx:id="sectionColumn" text="Section" prefWidth="150.0" />
                                    <TableColumn fx:id="roomColumn" text="Room Number" prefWidth="130.0" />
                                    <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="90.0" />
                                    <TableColumn fx:id="occupiedColumn" text="Occupied" prefWidth="90.0" />
                                    <TableColumn fx:id="availableColumn" text="Available" prefWidth="90.0" />
                                    <TableColumn fx:id="patientsColumn" text="Patients In Room" prefWidth="500.0" />
                                    <TableColumn fx:id="priorityColumn" text="Highest Priority" prefWidth="140.0" />
                                </columns>
                            </TableView>
                        </VBox>

                        <Label fx:id="fallbackStatusLabel" text="Room occupancy source not loaded yet." wrapText="true"
                               style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />

                        <Label fx:id="statusLabel" text="Room/bed occupancy not loaded yet."
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>