<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.AlertCenterController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Alert Center" styleClass="screen-title" />
                <Label text="SQLite alert preview. Acknowledge here updates SQLite only." styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label text="Severity" styleClass="field-label" />
                <ComboBox fx:id="severityFilter" prefWidth="150.0" />
                <Label text="Status" styleClass="field-label" />
                <ComboBox fx:id="statusFilter" prefWidth="170.0" />
                <Label text="Search" styleClass="field-label" />
                <TextField fx:id="searchField" promptText="Patient ID or name" HBox.hgrow="ALWAYS" />
                <Button text="Refresh" onAction="#loadAlerts" styleClass="secondary-button" />
                <Button text="Acknowledge" onAction="#acknowledgeSelected" styleClass="primary-button" />
            </HBox>
            <HBox fx:id="patientFilterBox" alignment="CENTER_LEFT" spacing="10.0" managed="false" visible="false">
                <Label fx:id="patientFilterChipLabel" text="" styleClass="filter-chip" />
                <Button text="Clear Patient Filter" onAction="#clearPatientFilter" styleClass="secondary-button" />
            </HBox>
            <SplitPane dividerPositions="0.68" VBox.vgrow="ALWAYS">
                <TableView fx:id="alertTable">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="115.0" />
                        <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="160.0" />
                        <TableColumn fx:id="severityColumn" text="Severity" prefWidth="120.0" />
                        <TableColumn fx:id="messageColumn" text="Message" prefWidth="310.0" />
                        <TableColumn fx:id="alertStatusColumn" text="Status" prefWidth="130.0" />
                        <TableColumn fx:id="createdAtColumn" text="Created" prefWidth="165.0" />
                        <TableColumn fx:id="updatedAtColumn" text="Last Updated" prefWidth="165.0" />
                        <TableColumn fx:id="acknowledgedByColumn" text="Acknowledged By" prefWidth="150.0" />
                        <TableColumn fx:id="acknowledgedAtColumn" text="Acknowledged At" prefWidth="165.0" />
                    </columns>
                </TableView>
                <VBox spacing="12.0" styleClass="panel-card">
                    <Label fx:id="detailTitleLabel" text="Alert Detail" styleClass="section-title" />
                    <VBox spacing="6.0">
                        <Label text="Patient" styleClass="metric-label" />
                        <Label fx:id="detailPatientLabel" text="-" styleClass="detail-value" wrapText="true" />
                    </VBox>
                    <HBox spacing="10.0">
                        <VBox spacing="6.0">
                            <Label text="Severity" styleClass="metric-label" />
                            <Label fx:id="detailSeverityLabel" text="-" />
                        </VBox>
                        <VBox spacing="6.0">
                            <Label text="Status" styleClass="metric-label" />
                            <Label fx:id="detailStatusLabel" text="-" />
                        </VBox>
                    </HBox>
                    <VBox spacing="6.0">
                        <Label text="Created" styleClass="metric-label" />
                        <Label fx:id="detailCreatedLabel" text="-" styleClass="body-text" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Last Updated" styleClass="metric-label" />
                        <Label fx:id="detailUpdatedLabel" text="-" styleClass="body-text" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Acknowledgement" styleClass="metric-label" />
                        <Label fx:id="detailAcknowledgedLabel" text="-" styleClass="body-text" wrapText="true" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Message" styleClass="metric-label" />
                        <TextArea fx:id="detailMessageArea" editable="false" wrapText="true" prefRowCount="4" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Recommended Action" styleClass="metric-label" />
                        <TextArea fx:id="recommendedActionArea" editable="false" wrapText="true" prefRowCount="5" />
                    </VBox>
                </VBox>
            </SplitPane>
            <Label fx:id="statusLabel" text="SQLite alerts loaded: 0" styleClass="status-pill" />
        </VBox>
    </center>
</BorderPane>
