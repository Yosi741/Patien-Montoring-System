<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
        spacing="16.0"
        prefWidth="560.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.DeviceAssignmentController" styleClass="panel-card">

    <Label
            text="Assign Device" styleClass="screen-title" />

    <Label
            fx:id="deviceLabel"
            text="Device"
            wrapText="true" styleClass="status-info metric-value compact-metric-value" />

    <VBox spacing="6.0">
        <Label
                text="Patient ID" styleClass="field-label" />

        <TextField
                fx:id="patientIdField"
                promptText="Patient ID" styleClass="control-input" />
    </VBox>

    <Label
            fx:id="statusLabel"
            text="-"
            wrapText="true" styleClass="status-success success-value" />

</VBox>
