<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="680.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicationFormController" styleClass="panel-card">

    <VBox spacing="4.0">
        <Label fx:id="titleLabel" text="Medication" styleClass="screen-title" />

        <Label text="Local database medication order. System data is stored in the local database."
               wrapText="true" styleClass="muted-text" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />

            <Label fx:id="patientIdLabel" text="-" styleClass="status-info metric-value compact-metric-value" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Medication Name" styleClass="field-label" />

            <TextField fx:id="nameField" promptText="Medication name" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Dose" styleClass="field-label" />

            <TextField fx:id="doseField" promptText="e.g. 500 mg" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Route" styleClass="field-label" />

            <TextField fx:id="routeField" promptText="Oral, IV, IM..." styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Frequency" styleClass="field-label" />

            <TextField fx:id="frequencyField" promptText="e.g. Twice daily" styleClass="control-input" />
        </VBox>

        <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Active Status" styleClass="field-label" />

            <CheckBox fx:id="activeCheckBox" text="Active medication" styleClass="success-value" />
        </VBox>
    </GridPane>

    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-success success-value" />
</VBox>
