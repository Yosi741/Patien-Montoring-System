<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="760.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicationFormController" styleClass="panel-card">

    <VBox spacing="4.0" styleClass="dialog-header-card">
        <Label fx:id="titleLabel" text="Medication" styleClass="screen-title dialog-title" />
        <Label text="Create or update a medication order using the medication catalog when available."
               wrapText="true" styleClass="muted-text dialog-subtitle" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />
            <Label fx:id="patientIdLabel" text="-" styleClass="status-info metric-value compact-metric-value" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Medication Catalog" styleClass="field-label" />
            <HBox spacing="8.0">
                <ComboBox fx:id="catalogMedicationBox" promptText="Search or type medication name"
                          maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="control-input" />
                <Button text="Register New Medication" onAction="#registerNewMedication" styleClass="secondary-button" />
            </HBox>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Dose Amount" styleClass="field-label" />
            <TextField fx:id="doseAmountField" promptText="Example: 500" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Dose Unit" styleClass="field-label" />
            <ComboBox fx:id="doseUnitField" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Route" styleClass="field-label" />
            <ComboBox fx:id="routeField" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Frequency" styleClass="field-label" />
            <ComboBox fx:id="frequencyField" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Active Status" styleClass="field-label" />
            <CheckBox fx:id="activeCheckBox" text="Active medication" styleClass="success-value" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Catalog Safety Info" styleClass="field-label" />
            <Label fx:id="safetyInfoLabel" text="Select a catalog medication to show dose and route guidance."
                   wrapText="true" styleClass="status-info" />
        </VBox>
    </GridPane>

    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-success success-value" />
</VBox>
