<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="620.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.UserFormController" styleClass="panel-card">

    <VBox spacing="4.0">
        <Label fx:id="titleLabel" text="User" styleClass="screen-title" />
        <Label fx:id="helpLabel" text="SQLite-only staff account write" wrapText="true" styleClass="muted-text" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Username" styleClass="field-label" />
            <TextField fx:id="usernameField" promptText="username" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Role" styleClass="field-label" />
            <ComboBox fx:id="roleBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Section / Department" styleClass="field-label" />
            <TextField fx:id="sectionField" promptText="All, ICU, ER, Pediatrics..." styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Active Status" styleClass="field-label" />
            <CheckBox fx:id="activeCheckBox" text="Active account" styleClass="compact-detail-value" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Password / New Password" styleClass="field-label" />
            <PasswordField fx:id="passwordField" promptText="Minimum 8 characters" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Confirm Password" styleClass="field-label" />
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label fx:id="passwordHelpLabel" text="Passwords are hashed before storage and are never displayed." wrapText="true" styleClass="muted-text" />

    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-success success-value" />
</VBox>
