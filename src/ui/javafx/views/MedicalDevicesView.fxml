<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="1150.0"
        prefHeight="720.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.MedicalDevicesController" styleClass="content-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Medical Devices" styleClass="screen-title" />
                <Label text="Device registration and assignment foundation. Real device integration is future work." styleClass="muted-text" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane"
                          managed="false"
                          visible="false"
                          spacing="10.0" styleClass="warning-panel">
                        <Label text="Access denied" styleClass="warning-value" />
                        <Label text="Medical Devices is available to Admin, Doctor, and Nurse roles for authorized hospital roles."
                               wrapText="true" styleClass="body-text" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Local database registration and assignment" styleClass="status-info metric-value compact-metric-value" />

                            <Label fx:id="patientFilterChip"
                                   text=""
                                   managed="false"
                                   visible="false" styleClass="status-success success-value" />

                            <Button fx:id="clearPatientFilterButton"
                                    text="Clear Patient Filter"
                                    onAction="#clearPatientFilter"
                                    managed="false"
                                    visible="false" styleClass="transparent-pane secondary-button" />
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />

                                <TextField fx:id="searchField"
                                           promptText="Device ID, name, serial, patient"
                                           HBox.hgrow="ALWAYS" styleClass="control-input" />

                                <Label text="Type" styleClass="field-label" />

                                <ComboBox fx:id="typeFilter"
                                          prefWidth="180.0" styleClass="control-input" />

                                <Label text="Status" styleClass="field-label" />

                                <ComboBox fx:id="statusFilter"
                                          prefWidth="150.0" styleClass="control-input" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <Button fx:id="registerButton" text="Register Device" onAction="#registerDevice" styleClass="primary-button" />

                                <Button fx:id="editButton" text="Edit Selected" onAction="#editSelectedDevice" styleClass="secondary-button" />

                                <Button fx:id="assignButton" text="Assign" onAction="#assignSelectedDevice" styleClass="secondary-button" />

                                <Button fx:id="unassignButton" text="Unassign" onAction="#unassignSelectedDevice" styleClass="secondary-button" />

                                <Button fx:id="deactivateButton" text="Deactivate" onAction="#deactivateSelectedDevice" styleClass="danger-button" />

                                <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />

                                <Button text="Refresh" onAction="#loadDevices" styleClass="secondary-button" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0" styleClass="panel-card">
                            <Label text="Registered Devices" styleClass="section-title" />

                            <TableView fx:id="deviceTable"
                                       prefHeight="520.0" styleClass="dialog-card">
                                <columns>
                                    <TableColumn fx:id="deviceIdColumn" text="Device ID" prefWidth="130.0" />
                                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0" />
                                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="170.0" />
                                    <TableColumn fx:id="serialColumn" text="Serial Number" prefWidth="150.0" />
                                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130.0" />
                                    <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="120.0" />
                                    <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="190.0" />
                                    <TableColumn fx:id="updatedAtColumn" text="Last Updated" prefWidth="170.0" />
                                </columns>
                            </TableView>
                        </VBox>

                        <Label fx:id="statusLabel"
                               text="Devices not loaded yet."
                               wrapText="true" styleClass="status-info metric-value compact-metric-value" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
