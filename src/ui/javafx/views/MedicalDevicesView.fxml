<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.controllers.MedicalDevicesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar compact-top-bar">
            <VBox spacing="4.0">
                <Label text="Medical Devices" styleClass="screen-title" />
                <Label text="SQLite registration and assignment foundation. Real device integration is future work." styleClass="muted-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="detail-scroll-pane">
            <content>
                <VBox spacing="16.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <VBox fx:id="accessDeniedPane" spacing="10.0" styleClass="panel-card" managed="false" visible="false">
                        <Label text="Access denied" styleClass="section-title" />
                        <Label text="Medical Devices is available to Admin, Doctor, and Nurse roles in this JavaFX preview." wrapText="true" styleClass="body-text" />
                    </VBox>
                    <VBox fx:id="contentPane" spacing="16.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="SQLite-only registration and assignment" styleClass="status-pill" />
                            <Label fx:id="patientFilterChip" text="" styleClass="filter-chip" managed="false" visible="false" />
                            <Button fx:id="clearPatientFilterButton" text="Clear Patient Filter" onAction="#clearPatientFilter" styleClass="secondary-button" managed="false" visible="false" />
                        </HBox>
                        <VBox spacing="12.0" styleClass="panel-card patient-filter-panel">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Search" styleClass="field-label" />
                                <TextField fx:id="searchField" promptText="Device ID, name, serial, patient" HBox.hgrow="ALWAYS" />
                                <Label text="Type" styleClass="field-label" />
                                <ComboBox fx:id="typeFilter" prefWidth="180.0" />
                                <Label text="Status" styleClass="field-label" />
                                <ComboBox fx:id="statusFilter" prefWidth="150.0" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <Button fx:id="registerButton" text="Register Device" onAction="#registerDevice" styleClass="primary-button" />
                                <Button fx:id="editButton" text="Edit Selected" onAction="#editSelectedDevice" styleClass="secondary-button" />
                                <Button fx:id="assignButton" text="Assign" onAction="#assignSelectedDevice" styleClass="primary-button" />
                                <Button fx:id="unassignButton" text="Unassign" onAction="#unassignSelectedDevice" styleClass="secondary-button" />
                                <Button fx:id="deactivateButton" text="Deactivate" onAction="#deactivateSelectedDevice" styleClass="danger-button" />
                                <Button text="Clear Filters" onAction="#clearFilters" styleClass="secondary-button" />
                                <Button text="Refresh" onAction="#loadDevices" styleClass="secondary-button" />
                            </HBox>
                        </VBox>
                        <VBox spacing="10.0" styleClass="panel-card">
                            <Label text="Registered Devices" styleClass="section-title" />
                            <TableView fx:id="deviceTable" prefHeight="520.0">
                                <columns>
                                    <TableColumn fx:id="deviceIdColumn" text="Device ID" prefWidth="130.0" />
                                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0" />
                                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="170.0" />
                                    <TableColumn fx:id="serialColumn" text="Serial Number" prefWidth="150.0" />
                                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130.0" />
                                    <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="120.0" />
                                    <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="190.0" />
                                    <TableColumn fx:id="updatedAtColumn" text="Last Updated" prefWidth="170.0" />
                                </columns>
                            </TableView>
                        </VBox>
                        <Label fx:id="statusLabel" text="Devices not loaded yet." wrapText="true" styleClass="status-pill" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
