<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="760.0"
        style="-fx-background-color: #F4F8FB;"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.controllers.AppLayoutController">

    <left>
        <VBox
                prefWidth="265.0"
                spacing="16.0"
                style="-fx-background-color: linear-gradient(to bottom, #0D47A1, #08306B);
                       -fx-padding: 22 18;">

            <VBox spacing="4.0">
                <Label
                        text="SPMS"
                        style="-fx-text-fill: white;
                               -fx-font-size: 30px;
                               -fx-font-weight: bold;" />

                <Label
                        text="JavaFX Hospital Preview"
                        wrapText="true"
                        style="-fx-text-fill: #BBDEFB;
                               -fx-font-size: 13px;" />
            </VBox>

            <VBox
                    spacing="4.0"
                    style="-fx-background-color: rgba(255,255,255,0.12);
                           -fx-background-radius: 16;
                           -fx-padding: 14;">

                <Label
                        fx:id="userLabel"
                        text="User"
                        style="-fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;" />

                <Label
                        fx:id="roleLabel"
                        text="Role | Section"
                        wrapText="true"
                        style="-fx-text-fill: #BBDEFB;
                               -fx-font-size: 12px;" />
            </VBox>

            <VBox spacing="8.0">

                <Button fx:id="dashboardButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="patientsButton" text="Patients" onAction="#showPatients" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="alertsButton" text="Alerts" onAction="#showAlerts" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="staffActivityButton" text="Staff Activity" onAction="#showStaffActivity" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="medicationOverviewButton" text="Medications" onAction="#showMedicationOverview" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="medicalDevicesButton" text="Medical Devices" onAction="#showMedicalDevices" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="medicalFilesButton" text="Medical Files" onAction="#showMedicalFiles" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="schedulingButton" text="Scheduling" onAction="#showScheduling" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="workQueueButton" text="Nurse Work Queue" onAction="#showWorkQueue" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="roomOccupancyButton" text="Rooms / Beds" onAction="#showRoomBedOccupancy" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="aiRecommendationsButton" text="AI Recommendations" onAction="#showAiRecommendations" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="backupExportButton" text="Backup / Export" onAction="#showBackupExport" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="userDirectoryButton" text="Staff / Users" onAction="#showUserDirectory" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="auditLogsButton" text="Audit Logs" onAction="#showAuditLogs" maxWidth="Infinity"
                        managed="false" visible="false"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

                <Button fx:id="settingsButton" text="Profile / Settings" onAction="#showSettings" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #E3F2FD; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Dark Mode" onAction="#toggleTheme" maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />

            <Button text="Logout" onAction="#logout" maxWidth="Infinity"
                    style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 14; -fx-cursor: hand;" />
        </VBox>
    </left>

    <center>
        <BorderPane style="-fx-background-color: #F4F8FB;">
            <top>
                <HBox alignment="CENTER_RIGHT" spacing="10.0"
                      style="-fx-background-color: white; -fx-padding: 14 22; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">

                    <Label fx:id="topUserLabel" text="User | Section"
                           style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />

                    <Label fx:id="roleBadgeLabel" text="UNKNOWN"
                           style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 16; -fx-padding: 6 12; -fx-font-size: 12px; -fx-font-weight: bold;" />

                    <Button text="Logout" onAction="#logout"
                            style="-fx-background-color: #FFEBEE; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 8 16; -fx-cursor: hand;" />
                </HBox>
            </top>

            <center>
                <BorderPane fx:id="contentPane" />
            </center>
        </BorderPane>
    </center>
</BorderPane>