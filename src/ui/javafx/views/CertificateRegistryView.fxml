<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200.0" prefHeight="760.0" style="-fx-background-color: #F4F8FB;"
            xmlns="http://javafx.com/javafx/17.0.15"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.javafx.controllers.CertificateRegistryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 18 24; -fx-border-color: transparent transparent #E0E7EF transparent; -fx-border-width: 0 0 1 0;">
            <VBox spacing="4.0">
                <Label text="Certificate Registry" style="-fx-text-fill: #0D47A1; -fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Unified SQLite birth and death certificate tracking with safe local HTML controls"
                       style="-fx-text-fill: #607D8B; -fx-font-size: 13px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 18; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

                    <Label fx:id="accessDeniedPane" managed="false" visible="false"
                           text="Access denied. Certificate Registry is available to authorized clinical users only."
                           wrapText="true"
                           style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-background-radius: 18; -fx-padding: 18; -fx-font-size: 15px; -fx-font-weight: bold;" />

                    <VBox fx:id="contentPane" spacing="18.0">
                        <HBox spacing="14.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Total Certificates" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="totalCertificatesLabel" text="0" style="-fx-text-fill: #0D47A1; -fx-font-size: 28px; -fx-font-weight: bold;" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Generated" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="generatedCertificatesLabel" text="0" style="-fx-text-fill: #00695C; -fx-font-size: 28px; -fx-font-weight: bold;" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Pending" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="pendingCertificatesLabel" text="0" style="-fx-text-fill: #E65100; -fx-font-size: 28px; -fx-font-weight: bold;" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Birth Records" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="birthCertificatesLabel" text="0" style="-fx-text-fill: #6A1B9A; -fx-font-size: 28px; -fx-font-weight: bold;" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Death Records" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="deathCertificatesLabel" text="0" style="-fx-text-fill: #455A64; -fx-font-size: 28px; -fx-font-weight: bold;" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="Type" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="typeFilter" prefWidth="125.0" />
                                <Label text="Status" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="statusFilter" prefWidth="140.0" />
                                <Label text="Review" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="reviewStatusFilter" prefWidth="165.0" />
                                <Label text="Date" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="145.0" />
                                <Label text="Section" style="-fx-text-fill: #263238; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <ComboBox fx:id="sectionFilter" prefWidth="160.0" />
                                <TextField fx:id="searchField" promptText="Patient/newborn ID or name" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <FlowPane alignment="CENTER_RIGHT" hgap="10.0" vgap="10.0">
                                <Button text="Open Related Record" onAction="#openRelatedRecord"
                                        style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="generateButton" text="Generate Certificate" onAction="#generateCertificate"
                                        style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="openCertificateButton" text="Open Certificate" onAction="#openCertificate"
                                        style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="Copy Summary" onAction="#copySummary"
                                        style="-fx-background-color: #F5F7FA; -fx-text-fill: #455A64; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="sendNoticeButton" text="Send Notice" onAction="#sendNotice"
                                        style="-fx-background-color: #EDE7F6; -fx-text-fill: #4527A0; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="submitReviewButton" text="Submit for Review" onAction="#submitForReview"
                                        style="-fx-background-color: #EEF5FF; -fx-text-fill: #0D47A1; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="approveButton" text="Approve" onAction="#approveCertificate"
                                        style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="rejectButton" text="Reject" onAction="#rejectCertificate"
                                        style="-fx-background-color: #FFEBEE; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="resetDraftButton" text="Reset Draft" onAction="#resetToDraft"
                                        style="-fx-background-color: #F5F7FA; -fx-text-fill: #455A64; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button fx:id="sendReviewNoteButton" text="Send Review Note" onAction="#sendReviewNote"
                                        style="-fx-background-color: #F5F7FA; -fx-text-fill: #455A64; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="Clear Filters" onAction="#clearFilters"
                                        style="-fx-background-color: #F5F7FA; -fx-text-fill: #455A64; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="Refresh" onAction="#loadCertificates"
                                        style="-fx-background-color: #E0F2F1; -fx-text-fill: #00695C; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 9 16; -fx-cursor: hand;" />
                            </FlowPane>
                        </VBox>

                        <HBox spacing="18.0">
                            <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Certificates" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <TableView fx:id="certificateTable" prefHeight="500.0">
                                    <columns>
                                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="85.0" />
                                        <TableColumn fx:id="sourceRecordColumn" text="Source ID" prefWidth="95.0" />
                                        <TableColumn fx:id="subjectIdColumn" text="Patient/Newborn ID" prefWidth="145.0" />
                                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0" />
                                        <TableColumn fx:id="eventTimeColumn" text="Event Time" prefWidth="165.0" />
                                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="110.0" />
                                        <TableColumn fx:id="reviewStatusColumn" text="Review" prefWidth="135.0" />
                                        <TableColumn fx:id="sectionColumn" text="Section" prefWidth="120.0" />
                                        <TableColumn fx:id="generatedAtColumn" text="Updated" prefWidth="160.0" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="12.0" prefWidth="360.0"
                                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 5);">
                                <Label text="Certificate Detail" style="-fx-text-fill: #263238; -fx-font-size: 17px; -fx-font-weight: bold;" />
                                <Label text="Record" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="detailTitleLabel" text="Select a certificate" wrapText="true" />
                                <Label text="Metadata" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="detailMetaLabel" text="-" wrapText="true" />
                                <Label text="Status" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="detailStatusLabel" text="No certificate selected." wrapText="true" />
                                <Label text="Review" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="detailReviewLabel" text="-" wrapText="true" />
                                <Label fx:id="detailWarningLabel" text="" wrapText="true"
                                       style="-fx-text-fill: #E65100; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label text="Validated Certificate Path" style="-fx-text-fill: #78909C; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label fx:id="detailPathLabel" text="-" wrapText="true" />
                            </VBox>
                        </HBox>

                        <Label fx:id="statusLabel" text="Certificate registry not loaded yet." wrapText="true"
                               style="-fx-background-color: #E3F2FD; -fx-text-fill: #0D47A1; -fx-background-radius: 18; -fx-padding: 8 14; -fx-font-size: 13px;" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
