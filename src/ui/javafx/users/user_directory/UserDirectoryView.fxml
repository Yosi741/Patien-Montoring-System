<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1150.0" styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.users.user_directory.UserDirectoryController">

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="screen-title" text="Staff/User Directory" />
                    <Label styleClass="muted-text" text="Read-only local database staff directory for Admin users" wrapText="true" />
                </VBox>
                <Button onAction="#showDashboard" styleClass="secondary-button" text="Back to Dashboard" />
            </HBox>

            <VBox fx:id="accessDeniedPane" managed="false" spacing="10.0" styleClass="warning-panel" visible="false">
                <Label styleClass="warning-value" text="Access denied" />
                <Label styleClass="body-text" text="The Staff/User Directory is visible only for Admin users for authorized hospital roles." wrapText="true" />
            </VBox>

            <VBox fx:id="directoryContentPane" spacing="16.0">

                <VBox spacing="12.0" styleClass="panel-card">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="field-label" text="Search" />
                        <TextField fx:id="searchField" promptText="Staff ID, username, or email" styleClass="control-input" HBox.hgrow="ALWAYS" />

                        <Label styleClass="field-label" text="Role" />
                        <ComboBox fx:id="roleFilter" prefWidth="130.0" styleClass="control-input" />

                        <Label styleClass="field-label" text="Section" />
                        <ComboBox fx:id="sectionFilter" prefWidth="150.0" styleClass="control-input" />

                        <Label styleClass="field-label" text="Status" />
                        <ComboBox fx:id="activeFilter" prefWidth="130.0" styleClass="control-input" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button onAction="#clearFilters" styleClass="secondary-button" text="Clear Filters" />

                        <Button onAction="#loadUsers" styleClass="secondary-button" text="Refresh" />
                    </HBox>
                </VBox>

                <SplitPane dividerPositions="0.66" styleClass="transparent-pane" VBox.vgrow="ALWAYS">

                    <VBox spacing="10.0" styleClass="panel-card">

                        <Label styleClass="section-title" text="Staff Users" />

                        <TableView fx:id="userTable" styleClass="dialog-card" VBox.vgrow="ALWAYS">
                            <columns>
                        <TableColumn fx:id="rowNumberColumn" prefWidth="50.0" resizable="false" text="#" />
                                <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" visible="false" />
                                <TableColumn fx:id="staffIdColumn" prefWidth="110.0" text="Staff ID" />
                                <TableColumn fx:id="usernameColumn" prefWidth="180.0" text="Username" />
                                <TableColumn fx:id="roleColumn" prefWidth="190.0" text="Role" />
                                <TableColumn fx:id="sectionColumn" prefWidth="180.0" text="Section / Department" />
                                <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Email" />
                                <TableColumn fx:id="activeColumn" prefWidth="100.0" text="Active" />
                                <TableColumn fx:id="createdAtColumn" prefWidth="185.0" text="Created At" />
                            </columns>
                        </TableView>
                    </VBox>

                    <ScrollPane fitToWidth="true" styleClass="scroll-clear">
                        <content>
                            <VBox spacing="16.0" styleClass="panel-card">

                                <Label fx:id="detailTitleLabel" styleClass="detail-value" text="Select a staff user" wrapText="true" />

                                <Label fx:id="detailRoleBadgeLabel" styleClass="status-info metric-value compact-metric-value" text="UNKNOWN" />

                                <GridPane hgap="12.0" vgap="12.0">
                                    <Label styleClass="metric-label" text="Staff ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="detailStaffIdLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label styleClass="metric-label" text="Username" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="detailUsernameLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label styleClass="metric-label" text="Role" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="detailRoleLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                    <Label styleClass="metric-label" text="Section" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Label fx:id="detailSectionLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                    <Label styleClass="metric-label" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                    <Label fx:id="detailEmailLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                    <Label styleClass="metric-label" text="Status" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                    <Label fx:id="detailStatusLabel" styleClass="success-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                    <Label styleClass="metric-label" text="Auth Source" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                    <Label fx:id="detailAuthSourceLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                    <Label styleClass="metric-label" text="Created At" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                                    <Label fx:id="detailCreatedAtLabel" styleClass="compact-detail-value" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                           <columnConstraints>
                              <ColumnConstraints />
                              <ColumnConstraints />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                                </GridPane>

                                <VBox spacing="10.0" styleClass="control-input">
                                    <Label styleClass="section-title" text="Permission Preview" />
                                    <VBox fx:id="permissionListBox" spacing="8.0" />
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </SplitPane>

                <Label fx:id="statusLabel" styleClass="status-info metric-value compact-metric-value" text="Users loaded: 0" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
