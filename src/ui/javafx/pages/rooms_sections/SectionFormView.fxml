<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/17.0.15"
      xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.javafx.pages.rooms_sections.SectionFormController" styleClass="panel-card dialog-root">

    <VBox spacing="4.0" styleClass="dialog-header-card">
        <Label fx:id="titleLabel" text="Section" styleClass="screen-title dialog-title" />
        <Label text="Create a hospital section and define its room capacity."
               wrapText="true" styleClass="muted-text dialog-subtitle" />
    </VBox>

    <VBox spacing="14.0" styleClass="form-card">
        <GridPane hgap="14.0" vgap="13.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Section Name" styleClass="field-label" />
                <TextField fx:id="nameField" promptText="Heart, Cardiology, Surgery..." styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Status" styleClass="field-label" />
                <ComboBox fx:id="statusBox" maxWidth="Infinity" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                <Label text="Notes" styleClass="field-label" />
                <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" promptText="Optional section notes" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Floor Number" styleClass="field-label" />
                <ComboBox fx:id="floorNumberBox" maxWidth="Infinity" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Room Prefix" styleClass="field-label" />
                <TextField fx:id="roomPrefixField" promptText="CAR" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label fx:id="roomCountLabel" text="Number of Rooms (0–500)" styleClass="field-label" />
                <TextField fx:id="roomCountField" promptText="0" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label text="Default Beds Per Room (1–20)" styleClass="field-label" />
                <TextField fx:id="capacityField" text="2" promptText="2" styleClass="control-input" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="4">
                <Label text="Current Rooms Count" styleClass="field-label" />
                <Label fx:id="currentRoomsCountLabel" text="-" styleClass="muted-text" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <Label text="Preview" styleClass="field-label" />
                <Label fx:id="roomEstimateLabel" text="Preview: Section will be created without rooms." wrapText="true" styleClass="muted-text" />
            </VBox>
        </GridPane>
    </VBox>

    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-info metric-value compact-metric-value" />
</VBox>
