<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.javafx.pages.newborns.NewbornRecordsController">

    

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-clear">
            <content>
                                <VBox spacing="18.0">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>

                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="screen-title" text="Newborn Records" />
                            <Label styleClass="muted-text" text="Newborn management and local HTML birth certificate foundation" wrapText="true" />
                        </VBox>
                        <Button onAction="#backToDashboard" styleClass="secondary-button" text="Back to Dashboard" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <VBox fx:id="accessDeniedPane" managed="false" spacing="10.0" styleClass="warning-panel" visible="false">
                        <Label styleClass="warning-value" text="Access denied" />
                        <Label styleClass="body-text" text="Newborn records are available to Admin, Doctor, and Nurse roles." wrapText="true" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">
                        <HBox spacing="14.0">
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Total Newborns" />
                                <Label fx:id="totalNewbornsLabel" styleClass="screen-title" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Births Today" />
                                <Label fx:id="birthsTodayLabel" styleClass="success-value" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Births This Month" />
                                <Label fx:id="birthsThisMonthLabel" styleClass="screen-title" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Certificates Generated" />
                                <Label fx:id="certificatesGeneratedLabel" styleClass="success-value" text="0" />
                            </VBox>
                            <VBox spacing="5.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="metric-label" text="Pending Certificates" />
                                <Label fx:id="pendingCertificatesLabel" styleClass="warning-value" text="0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label styleClass="field-label" text="Search" />
                                <TextField fx:id="searchField" promptText="Newborn ID, baby name, or mother" styleClass="control-input" HBox.hgrow="ALWAYS" />
                                <Label styleClass="field-label" text="Date" />
                                <ComboBox fx:id="dateRangeFilter" prefWidth="145.0" />
                                <Label styleClass="field-label" text="Section" />
                                <ComboBox fx:id="sectionFilter" prefWidth="160.0" />
                                <Label styleClass="field-label" text="Gender" />
                                <ComboBox fx:id="genderFilter" prefWidth="120.0" />
                            </HBox>
                            <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
                                <Label fx:id="motherFilterLabel" styleClass="status-info metric-value compact-metric-value" text="" />
                                <Button fx:id="addNewbornButton" onAction="#addNewborn" styleClass="primary-button" text="Add Newborn" />
                                <Button fx:id="editNewbornButton" onAction="#editNewborn" styleClass="secondary-button" text="Edit Selected" />
                                <Button fx:id="generateCertificateButton" onAction="#generateCertificate" styleClass="secondary-button" text="Generate Certificate" />
                                <Button fx:id="openCertificateButton" onAction="#openCertificate" styleClass="secondary-button" text="Open Certificate" />
                                <Button fx:id="sendBirthNoticeButton" onAction="#sendBirthNotice" styleClass="secondary-button" text="Send Birth Notice" />
                                <Button fx:id="copySummaryButton" onAction="#copySummary" styleClass="secondary-button" text="Copy Summary" />
                                <Button onAction="#clearFilters" styleClass="secondary-button" text="Clear" />
                            </FlowPane>
                        </VBox>

                        <HBox spacing="18.0">
                            <VBox spacing="10.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                                <Label styleClass="section-title" text="Records" />
                                                                <TableView fx:id="newbornTable" prefHeight="500.0" styleClass="clinical-table">
                                    <columns>
                                        <TableColumn fx:id="rowNumberColumn" prefWidth="55.0" sortable="false" text="#" />
                                        <TableColumn fx:id="newbornIdColumn" prefWidth="110.0" text="Newborn ID" />
                                        <TableColumn fx:id="babyNameColumn" prefWidth="150.0" text="Baby Name" />
                                        <TableColumn fx:id="genderColumn" prefWidth="90.0" text="Gender" />
                                        <TableColumn fx:id="birthTimeColumn" prefWidth="160.0" text="Birth Time" />
                                        <TableColumn fx:id="motherColumn" prefWidth="220.0" text="Mother" />
                                        <TableColumn fx:id="roomColumn" prefWidth="90.0" text="Room" />
                                        <TableColumn fx:id="sectionColumn" prefWidth="120.0" text="Section" />
                                        <TableColumn fx:id="certificateColumn" prefWidth="130.0" text="Certificate" />
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox prefWidth="360.0" spacing="12.0" styleClass="panel-card">
                                <Label styleClass="section-title" text="Newborn Detail" />
                                <Label styleClass="metric-label" text="Baby" />
                                <Label fx:id="detailBabyLabel" text="No newborn selected" wrapText="true" />
                                <Label styleClass="metric-label" text="Mother / Father" />
                                <Label fx:id="detailMotherLabel" text="-" wrapText="true" />
                                <Button fx:id="viewMotherFileButton" maxWidth="Infinity" onAction="#viewMotherFile" styleClass="secondary-button" text="View Mother File" />
                                <Label styleClass="metric-label" text="Birth Time" />
                                <Label fx:id="detailBirthLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Measurements" />
                                <Label fx:id="detailMeasurementsLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Delivery / Location" />
                                <Label fx:id="detailDeliveryLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Certificate Path" />
                                <Label fx:id="detailCertificateLabel" text="-" wrapText="true" />
                                <Label styleClass="metric-label" text="Notes" />
                                <Label fx:id="detailNotesLabel" text="Select a newborn record to view details." wrapText="true" />
                            </VBox>
                        </HBox>

                        <Label fx:id="statusLabel" styleClass="status-info metric-value compact-metric-value" text="Newborn records not loaded yet." wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
