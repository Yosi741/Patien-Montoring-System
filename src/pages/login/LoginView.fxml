<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="login-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.login.LoginController">

    <center>
        <StackPane styleClass="login-stage">
            <HBox maxHeight="610.0" maxWidth="1080.0" styleClass="login-shell-card">

                <!-- LEFT BRAND PANEL -->
                <VBox alignment="CENTER" prefWidth="455.0" spacing="22.0" styleClass="login-brand-panel">

                    <VBox alignment="CENTER" spacing="16.0" styleClass="login-brand-box">

                        <!-- BIGGER LOGO AREA -->
                        <StackPane prefHeight="240.0" prefWidth="455.0" styleClass="login-logo-zone">

                            <!-- REAL LOGO IMAGE -->
                            <ImageView fx:id="loginLogoImage" cache="true" fitHeight="235.0" fitWidth="430.0" preserveRatio="true" smooth="true" styleClass="login-logo-image" visible="false" />
                        </StackPane>

                        <VBox alignment="CENTER" spacing="14.0">
                            <Label styleClass="login-brand-title" text="CPMS" />

                            <Label alignment="CENTER" styleClass="login-brand-subtitle" text="Clinic Patient Monitoring System" textAlignment="CENTER" />
                        </VBox>
                    </VBox>

                    <Region prefHeight="8.0" />

                    <VBox alignment="CENTER" maxWidth="340.0" spacing="18.0">

                        <Label alignment="CENTER" styleClass="login-brand-message" text="Clinical workspace for patient monitoring" textAlignment="CENTER" wrapText="true" />

                        <Label alignment="CENTER" styleClass="login-brand-helper" text="Patients | Alerts | Appointments | Medical Files" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox alignment="CENTER" spacing="12.0" styleClass="login-security-strip">

                        <Label styleClass="login-security-icon" text="OK" />

                        <VBox spacing="2.0">
                            <Label styleClass="login-security-title" text="Protected clinical access" />

                            <Label styleClass="login-security-text" text="Private | Reliable | Local clinic system" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- RIGHT LOGIN FORM PANEL -->
                <VBox alignment="CENTER" prefWidth="625.0" spacing="28.0" styleClass="login-form-panel">

                    <VBox alignment="CENTER" spacing="10.0">
                        <StackPane styleClass="login-user-icon-wrap">
                            <Label styleClass="login-user-icon" text="Staff" />
                        </StackPane>

                        <Label styleClass="login-title" text="Welcome Back" />

                        <Label alignment="CENTER" styleClass="login-subtitle" text="Login to continue to your clinic workspace" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <VBox fillWidth="true" maxWidth="470.0" spacing="18.0">

                        <VBox spacing="8.0">
                            <Label styleClass="login-field-label" text="Username" />

                            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="login-input" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label styleClass="login-field-label" text="Password" />

                            <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Enter your password" styleClass="login-input" />
                        </VBox>
                    </VBox>

                    <VBox fillWidth="true" maxWidth="470.0" spacing="14.0">

                        <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="login-primary-button" text="Login" />

                        <HBox alignment="CENTER" spacing="14.0">
                            <Separator HBox.hgrow="ALWAYS" />
                            <Label styleClass="login-divider-text" text="or" />
                            <Separator HBox.hgrow="ALWAYS" />
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0">
                            <Button onAction="#handleForgotPasswordRequest" styleClass="login-link-button" text="Forgot Password?" />

                            <Button onAction="#handleClearLoginForm" styleClass="login-clear-button" text="Clear" />
                        </HBox>
                    </VBox>

                    <Label fx:id="statusLabel" alignment="CENTER" maxWidth="470.0" styleClass="login-status-text" textAlignment="CENTER" wrapText="true" />
                </VBox>
            </HBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="login-footer">

            <Label styleClass="login-footer-icon" text="OK" />

            <Label styleClass="login-footer-strong" text="System Status: Online" />

            <Label styleClass="login-footer-muted" text="|" />

            <Label styleClass="login-footer-muted" text="All systems operational" />

            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="login-footer-muted" text="Version 1.0.0" />
        </HBox>
    </bottom>
</BorderPane>
