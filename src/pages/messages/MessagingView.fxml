<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.messages.MessagingController">
    
    <center>
                <VBox spacing="16.0">
            <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="screen-title" text="Messaging" />
                    <Label styleClass="muted-text" text="Local internal staff messages." wrapText="true" />
                </VBox>
                <Button onAction="#showDashboard" styleClass="secondary-button" text="Back to Dashboard" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header-card">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" />
            <VBox layoutX="10.0" layoutY="10.0" spacing="4.0" />
            </HBox>
            <VBox fx:id="accessDeniedPane" managed="false" spacing="10" styleClass="panel-card" visible="false">
                <Label styleClass="section-title" text="Access denied" />
                <Label styleClass="body-text" text="Login is required to view messages." wrapText="true" />
            </VBox>
            <VBox fx:id="contentPane" spacing="14">
                <VBox spacing="10" styleClass="panel-card patient-filter-panel">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-label" text="Search" />
                        <TextField fx:id="searchField" promptText="Subject, message, sender, patient" HBox.hgrow="ALWAYS" />
                        <Label styleClass="field-label" text="Status" />
                        <ComboBox fx:id="statusFilter" prefWidth="150" />
                        <Label styleClass="field-label" text="Requests" />
                        <ComboBox fx:id="requestFilter" prefWidth="160" />
                        <Button onAction="#loadMessages" styleClass="secondary-button" text="Refresh" />
                    </HBox>
                </VBox>
                <SplitPane dividerPositions="0.66" prefHeight="600">
                    <TabPane>
                        <tabs>
                            <Tab closable="false" text="Inbox">
                                <TableView fx:id="inboxTable" styleClass="clinical-table">
                                    <columns>
                                        <TableColumn fx:id="inboxRowNumberColumn" prefWidth="55" sortable="false" text="#" />
                                        <TableColumn fx:id="inboxIdColumn" prefWidth="70" text="ID" visible="false" />
                                        <TableColumn fx:id="inboxSenderColumn" prefWidth="140" text="Sender" />
                                        <TableColumn fx:id="inboxSubjectColumn" prefWidth="240" text="Subject" />
                                        <TableColumn fx:id="inboxPriorityColumn" prefWidth="100" text="Priority" />
                                        <TableColumn fx:id="inboxStatusColumn" prefWidth="100" text="Status" />
                                        <TableColumn fx:id="inboxPatientColumn" prefWidth="110" text="Patient ID" />
                                        <TableColumn fx:id="inboxCreatedColumn" prefWidth="170" text="Created" />
                                    </columns>
                                </TableView>
                            </Tab>
                            <Tab closable="false" text="Sent">
                                <TableView fx:id="sentTable" styleClass="clinical-table">
                                    <columns>
                                        <TableColumn fx:id="sentRowNumberColumn" prefWidth="55" sortable="false" text="#" />
                                        <TableColumn fx:id="sentIdColumn" prefWidth="70" text="ID" visible="false" />
                                        <TableColumn fx:id="sentTargetColumn" prefWidth="160" text="Recipient" />
                                        <TableColumn fx:id="sentSubjectColumn" prefWidth="240" text="Subject" />
                                        <TableColumn fx:id="sentPriorityColumn" prefWidth="100" text="Priority" />
                                        <TableColumn fx:id="sentStatusColumn" prefWidth="100" text="Status" />
                                        <TableColumn fx:id="sentPatientColumn" prefWidth="110" text="Patient ID" />
                                        <TableColumn fx:id="sentCreatedColumn" prefWidth="170" text="Created" />
                                    </columns>
                                </TableView>
                            </Tab>
                            <Tab closable="false" text="Requests">
                                <TableView fx:id="requestTable" styleClass="clinical-table">
                                    <columns>
                                        <TableColumn fx:id="requestRowNumberColumn" prefWidth="55" sortable="false" text="#" />
                                        <TableColumn fx:id="requestTypeColumn" prefWidth="150" text="Type" />
                                        <TableColumn fx:id="requestFromColumn" prefWidth="120" text="From" />
                                        <TableColumn fx:id="requestToColumn" prefWidth="160" text="To" />
                                        <TableColumn fx:id="requestPatientColumn" prefWidth="110" text="Patient ID" />
                                        <TableColumn fx:id="requestSubjectColumn" prefWidth="220" text="Subject" />
                                        <TableColumn fx:id="requestPriorityColumn" prefWidth="90" text="Priority" />
                                        <TableColumn fx:id="requestStatusColumn" prefWidth="90" text="Status" />
                                        <TableColumn fx:id="requestCreatedColumn" prefWidth="160" text="Created" />
                                    </columns>
                                </TableView>
                            </Tab>
                            <Tab closable="false" text="Compose">
                                <ScrollPane fitToWidth="true" styleClass="detail-scroll-pane">
                                    <content>
                                        <VBox spacing="12" styleClass="panel-card">
                                            <HBox spacing="10">
                                                <Label styleClass="field-label" text="Recipient" />
                                                <ComboBox fx:id="targetTypeBox" managed="false" prefWidth="120" visible="false" />
                                                <ComboBox fx:id="targetUserBox" maxWidth="Infinity" promptText="Select exact staff recipient" HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="targetRoleBox" managed="false" prefWidth="140" visible="false" />
                                                <TextField fx:id="targetSectionField" managed="false" promptText="Section / Department" visible="false" />
                                            </HBox>
                                            <Label styleClass="muted-text" text="Choose the exact staff account. Free-text recipient names are disabled for safety." wrapText="true" />
                                            <HBox spacing="10">
                                                <TextField fx:id="patientIdField" prefWidth="180" promptText="Optional Patient ID" />
                                                <ComboBox fx:id="priorityBox" prefWidth="140" />
                                                <TextField fx:id="subjectField" promptText="Subject" HBox.hgrow="ALWAYS" />
                                            </HBox>
                                            <TextArea fx:id="bodyArea" prefRowCount="12" promptText="Message body" wrapText="true" />
                                            <Button onAction="#sendMessage" styleClass="primary-button" text="Send Message" />
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </Tab>
                        </tabs>
                    </TabPane>
                    <VBox spacing="12" styleClass="panel-card">
                        <Label fx:id="detailTitleLabel" styleClass="section-title" text="Select a message" wrapText="true" />
                        <Label fx:id="detailMetaLabel" styleClass="muted-text" text="-" wrapText="true" />
                        <Label fx:id="detailSourceLabel" styleClass="muted-text" text="Linked record: none" wrapText="true" />
                        <TextArea fx:id="detailBodyArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                        <FlowPane fx:id="certificateButtonPane" hgap="10" managed="false" vgap="10" visible="false">
                            <Button onAction="#openSourceRecord" styleClass="secondary-button" text="Open Related Record" />
                            <Button onAction="#openCertificate" styleClass="primary-button" text="Open Linked File" />
                        </FlowPane>
                        <FlowPane hgap="10" vgap="10">
                            <Button onAction="#markRead" styleClass="secondary-button" text="Mark Read" />
                            <Button onAction="#archiveMessage" styleClass="danger-button" text="Archive" />
                            <Button onAction="#openLinkedPatient" styleClass="secondary-button" text="Open Patient File" />
                        </FlowPane>
                    </VBox>
                </SplitPane>
                <Label fx:id="statusLabel" styleClass="status-pill" text="Messages not loaded yet." wrapText="true" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
