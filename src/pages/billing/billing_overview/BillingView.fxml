<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane styleClass="content-page billing-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.billing.billing_overview.BillingController">

    <center>
        <ScrollPane fitToWidth="true" styleClass="notification-scroll">
            <content>
                <VBox spacing="18.0" styleClass="billing-page">
                    <padding>
                        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" managed="false" spacing="10.0" styleClass="notification-card" visible="false">
                        <Label styleClass="notification-section-title" text="Access denied" />
                        <Label styleClass="notification-muted" text="Login is required to view billing." wrapText="true" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">
                        <VBox spacing="16.0" styleClass="billing-header">
                            <VBox spacing="6.0" styleClass="page-header-card">
                                <Label styleClass="page-header-subtitle" text="Manage local clinic visit invoices and payment status." wrapText="true" />
                            </VBox>

                            <GridPane hgap="14.0" styleClass="billing-metric-grid" vgap="14.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                </columnConstraints>

                                <VBox maxWidth="Infinity" spacing="8.0" styleClass="page-header-card billing-metric-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                    <Label styleClass="billing-metric-title" text="Total Revenue">
                              <font>
                                 <Font name="System Bold" size="14.0" />
                              </font></Label>
                                    <Label fx:id="totalRevenueLabel" styleClass="billing-metric-value" text="0.00" />
                                </VBox>
                                <VBox maxWidth="Infinity" spacing="8.0" styleClass="page-header-card billing-metric-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                                    <Label styleClass="billing-metric-title" text="Paid Invoices" />
                                    <Label fx:id="paidInvoicesLabel" styleClass="billing-metric-value" text="0" />
                                </VBox>
                                <VBox maxWidth="Infinity" spacing="8.0" styleClass="page-header-card billing-metric-card" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                                    <Label styleClass="billing-metric-title" text="Unpaid Invoices" />
                                    <Label fx:id="unpaidInvoicesLabel" styleClass="billing-metric-value" text="0" />
                                </VBox>
                                <VBox maxWidth="Infinity" spacing="8.0" styleClass="page-header-card billing-metric-card" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS">
                                    <Label styleClass="billing-metric-title" text="Cancelled" />
                                    <Label fx:id="cancelledInvoicesLabel" styleClass="billing-metric-value" text="0" />
                                </VBox>
                        <rowConstraints>
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                        </VBox>

                        <VBox spacing="12.0" styleClass="notification-filter-card billing-toolbar">
                            <FlowPane hgap="10.0" vgap="10.0">
                                <TextField fx:id="searchField" minHeight="35.0" minWidth="320.0" prefHeight="35.0" prefWidth="338.0" promptText="Search by invoice, patient ID, patient name..." styleClass="notification-input toolbar-text-field" />
                                <ComboBox fx:id="statusFilter" minHeight="35.0" minWidth="173.0" prefHeight="35.0" prefWidth="180.0" styleClass="notification-input toolbar-combo" />
                                <ComboBox fx:id="dateRangeFilter" minHeight="35.0" minWidth="180.0" prefHeight="35.0" prefWidth="180.0" styleClass="notification-input toolbar-combo" />
                                <Button onAction="#clearFilters" prefHeight="35.0" prefWidth="110.0" styleClass="secondary-button" text="Clear Filters" />
                                <Button fx:id="newInvoiceButton" onAction="#createInvoice" prefHeight="35.0" prefWidth="100.0" styleClass="new-invoice-button" text="+ New Invoice" />
                            </FlowPane>
                        </VBox>

                        <VBox spacing="10.0" styleClass="notification-list-card billing-table-card" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="notification-section-title" text="Invoice Register" />
                                    <Label styleClass="notification-subtitle" text="Local demo invoices only. No external payment gateway is connected." />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>

                            <TableView fx:id="billingTable" styleClass="clinical-table billing-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="invoiceColumn" prefWidth="150.0" text="Invoice" />
                                    <TableColumn fx:id="patientColumn" prefWidth="190.0" text="Patient" />
                                    <TableColumn fx:id="serviceColumn" prefWidth="190.0" text="Service" />
                                    <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Amount" />
                                    <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                                    <TableColumn fx:id="paymentColumn" prefWidth="130.0" text="Payment" />
                                    <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
                                    <TableColumn fx:id="actionsColumn" prefWidth="140.0" text="Actions" />
                                </columns>
                            </TableView>

                            <Label fx:id="statusLabel" styleClass="status-pill" text="Billing page not loaded yet." wrapText="true" />
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
