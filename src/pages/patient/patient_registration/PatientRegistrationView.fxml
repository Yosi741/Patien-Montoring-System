<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefWidth="700.0"
        prefHeight="520.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="pages.patient.patient_registration.PatientRegistrationController" styleClass="panel-card dialog-root patient-form-dialog">

    <top>
    <VBox spacing="4.0" styleClass="dialog-header-card">
        <Label fx:id="titleLabel" text="Patient" styleClass="screen-title dialog-title" />

        <Label fx:id="helpLabel" text="Patient file form" wrapText="true" styleClass="muted-text dialog-subtitle" />
    </VBox>
    </top>

    <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="patient-form-scroll">
        <content>
        <VBox spacing="16.0" styleClass="patient-form-content">
    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />
            <HBox spacing="8.0">
                <TextField fx:id="patientIdField" promptText="9-digit patient ID" styleClass="control-input" HBox.hgrow="ALWAYS" />
                <Button fx:id="checkPatientIdButton" onAction="#checkExistingPatientId" styleClass="secondary-button" text="Check ID" />
            </HBox>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Birth Date" styleClass="field-label" />
            <DatePicker fx:id="birthDatePicker" promptText="dd-MM-yyyy" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="First Name" styleClass="field-label" />
            <TextField fx:id="firstNameField" promptText="First name" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Last Name" styleClass="field-label" />
            <TextField fx:id="lastNameField" promptText="Last name" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Gender" styleClass="field-label" />
            <ComboBox fx:id="genderBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Status" styleClass="field-label" />
            <ComboBox fx:id="statusBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Priority" styleClass="field-label" />
            <ComboBox fx:id="priorityBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Blood Type" styleClass="field-label" />
            <ComboBox fx:id="bloodTypeBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Allergy Status" styleClass="field-label" />
            <ComboBox fx:id="allergyStatusBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox fx:id="allergyDetailsContainer" spacing="6.0" visible="false" managed="false" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
            <Label text="Allergy Details" styleClass="field-label" />
            <TextArea fx:id="allergyDetailsArea" promptText="Example: Penicillin, peanuts, latex..." prefRowCount="3" wrapText="true" styleClass="control-input" />
        </VBox>

        <Label text="Contact Info" styleClass="field-label contact-info-section" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6" />

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="7">
            <Label text="Phone" styleClass="field-label" />
            <TextField fx:id="phoneField" promptText="Phone number" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
            <Label text="Email" styleClass="field-label" />
            <TextField fx:id="emailField" promptText="Email address" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="8">
            <Label text="Emergency Contact Name" styleClass="field-label" />
            <TextField fx:id="emergencyContactNameField" promptText="Emergency contact name" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="8">
            <Label text="Emergency Contact Phone" styleClass="field-label" />
            <TextField fx:id="emergencyContactPhoneField" promptText="Emergency contact phone" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="9">
            <Label text="Address" styleClass="field-label" />
            <TextArea fx:id="addressArea" promptText="Address" prefRowCount="2" wrapText="true" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="10">
            <Label text="Visit Reason / Diagnosis" styleClass="field-label" />
            <TextArea fx:id="diagnosisArea" promptText="Short visit reason, diagnosis, or clinical note" prefRowCount="4" wrapText="true" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label fx:id="statusLabel" text="-" maxWidth="Infinity" wrapText="true" styleClass="status-success success-value" />
        </VBox>
        </content>
    </ScrollPane>
    </center>
</BorderPane>

