<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1150.0" styleClass="content-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.patient.patient_board.PatientListController">

    <center>
        <ScrollPane fitToWidth="true" styleClass="patient-board-scroll">
            <content>
                <VBox spacing="18.0" styleClass="patient-management-page">
                    <padding>
                        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="page-header-card patient-header">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="screen-title page-header-title patient-page-title" text="Patient Management" />
                            <Label styleClass="muted-text page-header-subtitle patient-page-subtitle" text="Manage patient records and urgent care visits." wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox spacing="14.0" styleClass="patient-table-card">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="patient-toolbar">
                            <TextField fx:id="searchField" prefHeight="30.0" prefWidth="713.0" promptText="Search by name, patient ID, phone, or email..." styleClass="global-search-field patient-search-field" HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="statusFilter" prefHeight="30.0" prefWidth="180.0" styleClass="control-input patient-status-filter" />
                            <Button onAction="#clearFilters" prefHeight="32.0" prefWidth="65.0" styleClass="secondary-button patient-toolbar-button" text="Clear" />
                            <Button fx:id="addPatientButton" onAction="#addPatient" prefHeight="32.0" prefWidth="106.0" styleClass="primary-button add-patient-button patient-toolbar-button" text="+ Add Patient" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label fx:id="statusLabel" styleClass="patient-status-line" text="Showing 0 patient records" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>

                        <TableView fx:id="patientTable" prefHeight="520.0" styleClass="patient-table clinical-table patient-management-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="patientColumn" prefWidth="330.0" text="Patient" />
                                <TableColumn fx:id="idColumn" prefWidth="135.0" text="ID" />
                                <TableColumn fx:id="ageGenderColumn" prefWidth="140.0" text="Age / Gender" />
                                <TableColumn fx:id="contactColumn" prefWidth="190.0" text="Contact" />
                                <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Status" />
                                <TableColumn fx:id="actionsColumn" prefWidth="190.0" sortable="false" text="Actions" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
