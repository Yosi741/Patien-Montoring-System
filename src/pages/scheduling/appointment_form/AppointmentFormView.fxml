<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        spacing="16.0"
        prefWidth="760.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="pages.scheduling.appointment_form.AppointmentFormController" styleClass="panel-card dialog-root">

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="dialog-header-card">
        <VBox spacing="4.0">
            <Label
                    fx:id="titleLabel"
                    text="Appointment" styleClass="screen-title dialog-title" />

            <Label
                    text="Schedule an urgent care visit, follow-up, or clinic checkup."
                    wrapText="true" styleClass="muted-text dialog-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />
            <TextField fx:id="patientIdField" promptText="9-digit patient ID" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Type" styleClass="field-label" />
            <ComboBox fx:id="typeBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Status" styleClass="field-label" />
            <ComboBox fx:id="statusBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Appointment Date" styleClass="field-label" />
            <DatePicker fx:id="appointmentDatePicker" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Available Time" styleClass="field-label" />
            <ComboBox fx:id="startTimeBox" maxWidth="Infinity" promptText="Select appointment time" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Duration" styleClass="field-label" />
            <ComboBox fx:id="durationBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
            <Label text="Notes" styleClass="field-label" />
            <TextArea fx:id="notesArea" prefRowCount="4" wrapText="true" promptText="Optional scheduling notes" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label
            fx:id="statusLabel"
            text="-"
            maxWidth="Infinity"
            wrapText="true" styleClass="status-info metric-value compact-metric-value" />
</VBox>
