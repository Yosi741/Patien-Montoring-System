<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        styleClass="content-page notification-root"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="pages.notification.NotificationCenterController">

    <center>
        <ScrollPane fitToWidth="true" styleClass="notification-scroll">
            <content>
                <VBox spacing="18.0" styleClass="notification-page">
                    <padding>
                        <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                    </padding>

                    <VBox fx:id="accessDeniedPane" spacing="10.0" styleClass="notification-card" managed="false" visible="false">
                        <Label text="Access denied" styleClass="notification-section-title" />
                        <Label text="Login is required to view notifications." wrapText="true" styleClass="notification-muted" />
                    </VBox>

                    <VBox fx:id="contentPane" spacing="18.0">
                        <VBox spacing="16.0" styleClass="alerts-header">
                            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="page-header-card">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Alerts &amp; Notifications" styleClass="screen-title page-header-title" />
                                    <Label text="Review patient alerts and system updates for the clinic." styleClass="muted-text page-header-subtitle" wrapText="true" />
                                </VBox>
                            </HBox>

                            <GridPane hgap="12.0" vgap="12.0" styleClass="alerts-metrics-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                </columnConstraints>

                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="notification-counter-card alerts-metric-card">
                                    <Label text="Unread" styleClass="notification-counter-label" />
                                    <Label fx:id="unreadCountLabel" text="0" styleClass="notification-counter-value notification-counter-unread" />
                                </VBox>
                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="notification-counter-card alerts-metric-card">
                                    <Label text="Critical" styleClass="notification-counter-label" />
                                    <Label fx:id="criticalCountLabel" text="0" styleClass="notification-counter-value notification-counter-critical" />
                                </VBox>
                                <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="notification-counter-card alerts-metric-card">
                                    <Label text="Active Alerts" styleClass="notification-counter-label" />
                                    <Label fx:id="alertsCountLabel" text="0" styleClass="notification-counter-value" />
                                </VBox>
                                <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="notification-counter-card alerts-metric-card">
                                    <Label text="System Updates" styleClass="notification-counter-label" />
                                    <Label fx:id="systemCountLabel" text="0" styleClass="notification-counter-value" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox spacing="12.0" styleClass="notification-filter-card alerts-filter-card">
                            <FlowPane hgap="10.0" vgap="10.0">
                                <Button text="All" onAction="#showAll" styleClass="notification-filter-chip" />
                                <Button text="Unread" onAction="#showUnread" styleClass="notification-filter-chip" />
                                <Button text="Critical" onAction="#showCritical" styleClass="notification-filter-chip-critical" />
                                <Button text="System" onAction="#showSystem" styleClass="notification-filter-chip" />
                            </FlowPane>

                            <GridPane hgap="14.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="34.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0" />
                                </columnConstraints>

                                <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Patient" styleClass="field-label" />
                                    <TextField fx:id="patientSearchField" promptText="Patient ID" prefWidth="320.0" minHeight="44.0" prefHeight="44.0" styleClass="notification-input toolbar-text-field" />
                                </VBox>
                                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Severity" styleClass="field-label" />
                                    <ComboBox fx:id="severityFilter" prefWidth="200.0" minHeight="44.0" prefHeight="44.0" maxWidth="Infinity" styleClass="notification-input toolbar-combo" />
                                </VBox>
                                <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Status" styleClass="field-label" />
                                    <ComboBox fx:id="statusFilter" prefWidth="200.0" minHeight="44.0" prefHeight="44.0" maxWidth="Infinity" styleClass="notification-input toolbar-combo" />
                                </VBox>
                                <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <Label text="Date" styleClass="field-label" />
                                    <ComboBox fx:id="dateRangeFilter" prefWidth="200.0" minHeight="44.0" prefHeight="44.0" maxWidth="Infinity" styleClass="notification-input toolbar-combo" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS" styleClass="notification-list-card alerts-list-card">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                    <Label text="Alerts Feed" styleClass="notification-section-title" />
                                    <Label text="Grouped by date, newest first. Use the eye icon to view details." styleClass="notification-subtitle" />
                                </VBox>
                            </HBox>

                            <ListView fx:id="notificationList" prefHeight="560.0" VBox.vgrow="ALWAYS" styleClass="notification-list" />
                            <Label fx:id="statusLabel" text="Alerts not loaded yet." wrapText="true" styleClass="status-pill" />
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
