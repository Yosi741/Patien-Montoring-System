<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="16.0"
        prefWidth="660.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="pages.room_section.room_assignment.RoomAssignmentController" styleClass="panel-card">

    <VBox spacing="4.0">
        <Label fx:id="titleLabel" text="Patient Room Assignment" styleClass="screen-title" />
        <Label text="Assign, move, or remove an active patient from a SQLite room record."
               wrapText="true" styleClass="muted-text" />
    </VBox>

    <GridPane hgap="14.0" vgap="13.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient ID" styleClass="field-label" />
            <TextField fx:id="patientIdField" promptText="9-digit patient ID" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Destination Room" styleClass="field-label" />
            <ComboBox fx:id="roomBox" maxWidth="Infinity" styleClass="control-input" />
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
            <Label text="Notes" styleClass="field-label" />
            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" promptText="Optional notes for staff context" styleClass="control-input" />
        </VBox>
    </GridPane>

    <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="status-info metric-value compact-metric-value" />
</VBox>
