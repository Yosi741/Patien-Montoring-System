<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" prefHeight="780.0" prefWidth="860.0" styleClass="detail-scroll-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.user.user_form.UserFormController">
    <content>
        <VBox spacing="18.0" styleClass="panel-card dialog-root staff-form-root">
            <padding>
                <Insets bottom="14.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <VBox spacing="4.0" styleClass="dialog-header-card staff-form-header-card">
                <Label fx:id="titleLabel" styleClass="screen-title dialog-title" text="Add Staff" />
                <Label fx:id="helpLabel" styleClass="muted-text dialog-subtitle" text="Create a clinic staff account with role and duty status." wrapText="true" />
            </VBox>

            <HBox spacing="20.0" styleClass="staff-form-content-card staff-form-hero">
                <VBox alignment="TOP_CENTER" minWidth="214.0" prefWidth="214.0" spacing="14.0" styleClass="staff-photo-card staff-form-photo-card">
                    <StackPane styleClass="staff-form-avatar-frame">
                        <ImageView fx:id="photoPreviewImage" fitHeight="112.0" fitWidth="112.0" managed="false" preserveRatio="true" smooth="true" visible="false" />
                        <Label fx:id="photoInitialsLabel" styleClass="staff-avatar-initials staff-form-avatar-initials" text="SC" />
                    </StackPane>
                    <VBox alignment="CENTER" spacing="4.0">
                        <Label styleClass="section-title staff-form-photo-title" text="Profile Photo" />
                        <Label fx:id="photoPathLabel" styleClass="muted-text staff-photo-path-label" text="No profile photo selected" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="8.0">
                        <Button fx:id="uploadPhotoButton"
                                minWidth="108.0"
                                prefWidth="108.0"
                                onAction="#chooseProfilePhoto"
                                styleClass="secondary-button photo-action-button"
                                text="Upload" />
                        <Button fx:id="removePhotoButton"
                                minWidth="108.0"
                                prefWidth="108.0"
                                onAction="#removeProfilePhoto"
                                styleClass="secondary-button photo-action-button"
                                text="Remove" />
                    </VBox>
                    <Region VBox.vgrow="ALWAYS" />
                </VBox>

                <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="12.0" styleClass="staff-form-section-card">
                        <Label styleClass="staff-form-section-title" text="Account Details" />
                        <GridPane hgap="14.0" styleClass="staff-form-grid" vgap="13.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Staff ID" />
                                <TextField fx:id="staffIdField" editable="false" focusTraversable="false" promptText="U0001" styleClass="control-input staff-form-generated-id staff-form-readonly-field" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Full Name" />
                                <TextField fx:id="fullNameField" promptText="Dr. Sarah Johnson" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label styleClass="field-label" text="Username" />
                                <TextField fx:id="usernameField" promptText="username" styleClass="control-input" />
                                <Label fx:id="usernameHelpLabel" styleClass="muted-text staff-form-helper-text" text="" wrapText="true" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label styleClass="field-label" text="Role" />
                                <ComboBox fx:id="roleBox" maxWidth="Infinity" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label styleClass="field-label" text="Duty Status" />
                                <ComboBox fx:id="dutyStatusBox" maxWidth="Infinity" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label styleClass="field-label" text="Account Status" />
                                <CheckBox fx:id="activeCheckBox" styleClass="compact-detail-value staff-form-active-check" text="Active account" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12.0" styleClass="staff-form-section-card">
                        <Label styleClass="staff-form-section-title" text="Contact Information" />
                        <GridPane hgap="14.0" styleClass="staff-form-grid" vgap="13.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Email" />
                                <TextField fx:id="emailField" promptText="name@clinic.local" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Phone" />
                                <TextField fx:id="phoneField" promptText="+970 59 000 0000" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label styleClass="field-label" text="Address" />
                                <TextArea fx:id="addressArea" prefRowCount="3" promptText="Clinic address or staff contact address" styleClass="control-input" wrapText="true" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12.0" styleClass="staff-form-section-card">
                        <Label styleClass="staff-form-section-title" text="Login Password" />
                        <GridPane hgap="14.0" styleClass="staff-form-grid" vgap="13.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Password" />
                                <PasswordField fx:id="passwordField" promptText="Minimum 8 characters" styleClass="control-input" />
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="Confirm Password" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" styleClass="control-input" />
                            </VBox>
                        </GridPane>
                        <Label fx:id="passwordHelpLabel" styleClass="muted-text staff-form-helper-text" text="Password is used for local demo login and is never shown on screen." wrapText="true" />
                    </VBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="14.0" styleClass="staff-form-footer">
                <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="status-success success-value staff-form-status" text="-" wrapText="true" HBox.hgrow="ALWAYS" />
                <Button fx:id="cancelButton" cancelButton="true" onAction="#closeDialog" styleClass="secondary-button" text="Cancel" />
                <Button fx:id="saveButton" defaultButton="true" onAction="#submitForm" styleClass="primary-button" text="Save" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
