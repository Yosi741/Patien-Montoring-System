<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="content-page staff-page" xmlns="http://javafx.com/javafx/17.0.15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pages.user.user_directory.UserDirectoryController">
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="page-header-card staff-header">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Staff Management" styleClass="screen-title" />
                    <Label text="Manage urgent care clinic staff and schedules." styleClass="muted-text page-subtitle" wrapText="true" />
                </VBox>
            </HBox>

            <VBox fx:id="accessDeniedPane" managed="false" visible="false" spacing="10.0" styleClass="panel-card">
                <Label text="Access denied" styleClass="section-title" />
                <Label text="Staff management is available only to authorized clinic administrators." wrapText="true" styleClass="body-text" />
            </VBox>

            <VBox fx:id="directoryContentPane" spacing="16.0" VBox.vgrow="ALWAYS">
                <HBox spacing="14.0" styleClass="staff-metrics-row">
                    <VBox spacing="6.0" styleClass="panel-card staff-metric-card staff-metric-blue" HBox.hgrow="ALWAYS">
                        <Label text="Total Staff" styleClass="metric-title" />
                        <Label fx:id="totalStaffMetricLabel" text="0" styleClass="metric-value staff-metric-value" />
                    </VBox>
                    <VBox spacing="6.0" styleClass="panel-card staff-metric-card staff-metric-green" HBox.hgrow="ALWAYS">
                        <Label text="On Duty" styleClass="metric-title" />
                        <Label fx:id="onDutyMetricLabel" text="0" styleClass="metric-value staff-metric-value success-value" />
                    </VBox>
                    <VBox spacing="6.0" styleClass="panel-card staff-metric-card staff-metric-cyan" HBox.hgrow="ALWAYS">
                        <Label text="Off Duty" styleClass="metric-title" />
                        <Label fx:id="offDutyMetricLabel" text="0" styleClass="metric-value staff-metric-value warning-value" />
                    </VBox>
                    <VBox spacing="6.0" styleClass="panel-card staff-metric-card staff-metric-purple" HBox.hgrow="ALWAYS">
                        <Label text="On Leave" styleClass="metric-title" />
                        <Label fx:id="onLeaveMetricLabel" text="0" styleClass="metric-value staff-metric-value accent-value" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="panel-card staff-filter-bar">
                    <TextField fx:id="searchField" promptText="Search staff by full name, username, or staff ID" HBox.hgrow="ALWAYS" styleClass="staff-search-field toolbar-text-field" />
                    <ComboBox fx:id="roleFilter" prefWidth="180.0" minHeight="44.0" prefHeight="44.0" styleClass="control-input toolbar-combo" />
                    <ComboBox fx:id="activeFilter" prefWidth="180.0" minHeight="44.0" prefHeight="44.0" styleClass="control-input toolbar-combo" />
                    <Button text="Clear Filters" onAction="#clearFilters" minWidth="120.0" minHeight="44.0" prefHeight="44.0" styleClass="secondary-button toolbar-secondary-button" />
                    <Button fx:id="addUserButton" text="Add Staff" onAction="#addUser" minWidth="160.0" minHeight="44.0" prefHeight="44.0" styleClass="primary-button toolbar-primary-button add-staff-button" />
                </HBox>

                <VBox spacing="12.0" styleClass="panel-card staff-table-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Clinic Staff" styleClass="section-title" />
                            <Label text="View, edit, and review staff account availability from one place." styleClass="muted-text" wrapText="true" />
                        </VBox>
                    </HBox>

                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="clinical-table staff-directory-table">
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="Staff" prefWidth="340.0" />
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="170.0" />
                            <TableColumn fx:id="activeColumn" text="Status" prefWidth="170.0" />
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="170.0" sortable="false" />
                        </columns>
                    </TableView>
                </VBox>

                <Label fx:id="statusLabel" text="Staff records loaded: 0" wrapText="true" styleClass="status-pill staff-footer-note" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
