<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1280.0"
            prefHeight="800.0"
            xmlns="http://javafx.com/javafx/17.0.15"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.layout.AppLayoutController"
            styleClass="app-root">

    <left>
        <VBox prefWidth="260.0" spacing="18.0" styleClass="app-sidebar">
            <padding>
                <Insets top="24.0" right="18.0" bottom="18.0" left="18.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-logo-block">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoImage"
                               fitWidth="42.0"
                               fitHeight="42.0"
                               preserveRatio="true"
                               smooth="true"
                               styleClass="sidebar-logo-image" />
                </StackPane>
                <VBox spacing="2.0">
                    <Label text="SmartCare" styleClass="shell-brand-title" />
                    <Label text="Urgent Care Clinic" styleClass="shell-brand-subtitle" />
                </VBox>
            </HBox>

            <VBox spacing="8.0">
                <Button fx:id="dashboardButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
                <Button fx:id="appointmentsButton" text="Appointments" onAction="#showAppointments" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
                <Button fx:id="patientsButton" text="Patients" onAction="#showPatients" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
                <Button fx:id="medicalFilesButton" text="Medical Files" onAction="#showMedicalFiles" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
                <Button fx:id="billingButton" text="Billing" onAction="#showBilling" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
                <Button fx:id="staffManagementButton" text="Staff Management" onAction="#showUserDirectory" maxWidth="Infinity"
                        styleClass="sidebar-nav-button" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="12.0" styleClass="sidebar-user-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="profile-avatar-circle">
                        <Label fx:id="sidebarAvatarLabel" text="S" styleClass="profile-avatar-text" />
                    </StackPane>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="userLabel" text="User" styleClass="shell-user-name" />
                        <Label fx:id="roleLabel" text="Role" styleClass="shell-user-meta" />
                    </VBox>
                </HBox>
                <Button fx:id="sidebarLogoutButton" text="Logout" onAction="#logout" maxWidth="Infinity"
                        styleClass="secondary-button" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0" styleClass="page-container">
            <padding>
                <Insets top="18.0" right="22.0" bottom="20.0" left="22.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="app-top-bar">
                <VBox spacing="4.0">
                    <Label fx:id="breadcrumbLabel" text="Home / Dashboard" styleClass="muted-text" />
                    <Label fx:id="currentPageLabel" text="Dashboard" styleClass="screen-title" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="globalSearchField"
                           promptText="Search patients, appointments..."
                           styleClass="global-search-field" />

                <Label fx:id="dateTimeLabel" text="--" styleClass="muted-text top-bar-datetime" />

                <MenuButton fx:id="quickActionsButton" text="+ Quick Actions" styleClass="quick-actions-button">
                    <items>
                        <MenuItem text="Check-in Patient" onAction="#handleQuickCheckIn" />
                        <MenuItem text="Add Patient" onAction="#handleQuickAddPatient" />
                        <MenuItem text="Enter Vitals" onAction="#handleQuickEnterVitals" />
                        <MenuItem text="New Appointment" onAction="#handleQuickNewAppointment" />
                        <MenuItem text="Add Payment" onAction="#handleQuickAddPayment" />
                        <MenuItem text="Send Message" onAction="#handleQuickSendMessage" />
                    </items>
                </MenuButton>

                <Button fx:id="alertsIconButton" text="🔔 0" onAction="#showNotifications" styleClass="top-icon-button notification-icon-button" />

                <Button fx:id="messagesIconButton" text="💬 0" onAction="#showMessages" styleClass="top-icon-button message-icon-button" />

                <Button fx:id="themeToggleButton" text="☀" onAction="#toggleTheme" styleClass="top-icon-button theme-icon-button" />

                <MenuButton fx:id="profileMenuButton" text="" styleClass="profile-chip">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane styleClass="profile-avatar-circle">
                                <Label fx:id="profileChipAvatarLabel" text="S" styleClass="profile-avatar-text" />
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label fx:id="profileChipNameLabel" text="User" styleClass="profile-chip-name" />
                                <Label fx:id="profileChipRoleLabel" text="Role" styleClass="profile-chip-meta" />
                            </VBox>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profile / Settings" onAction="#showSettings" />
                        <MenuItem text="Messages" onAction="#showMessages" />
                        <MenuItem text="Logout" onAction="#logout" />
                    </items>
                </MenuButton>
            </HBox>

            <Label fx:id="contextNoticeLabel"
                   text="Context notice"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   styleClass="status-info" />

            <BorderPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="content-root" />
        </VBox>
    </center>
</BorderPane>
