<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.layout.AppLayoutController">

    <left>
        <VBox prefWidth="280.0" spacing="18.0" styleClass="app-sidebar">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="sidebar-logo-block">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoImage" fitHeight="42.0" fitWidth="42.0" preserveRatio="true" smooth="true" styleClass="sidebar-logo-image" />
                </StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="shell-brand-title" text="ClinicPulse" />
                    <Label maxWidth="Infinity" styleClass="shell-brand-subtitle" text="Smart Patient Monitoring System" wrapText="true" />
                </VBox>
            </HBox>

            <VBox spacing="8.0">
                <Button fx:id="dashboardButton" maxWidth="Infinity" onAction="#showDashboard" styleClass="sidebar-nav-button" text="Dashboard" />
                <Button fx:id="patientsButton" maxWidth="Infinity" onAction="#showPatients" styleClass="sidebar-nav-button" text="Patients" />
                <Button fx:id="appointmentsButton" maxWidth="Infinity" onAction="#showAppointments" styleClass="sidebar-nav-button" text="Appointments" />
                <Button fx:id="medicalFilesButton" maxWidth="Infinity" onAction="#showMedicalFiles" styleClass="sidebar-nav-button" text="Medical Files" />
                <Button fx:id="billingButton" maxWidth="Infinity" onAction="#showBilling" styleClass="sidebar-nav-button" text="Billing" />
                <Button fx:id="staffManagementButton" maxWidth="Infinity" onAction="#showUserDirectory" styleClass="sidebar-nav-button" text="Staff Management" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="12.0" styleClass="sidebar-user-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="profile-avatar-circle">
                        <Label fx:id="sidebarAvatarLabel" styleClass="profile-avatar-text" text="S" />
                    </StackPane>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="userLabel" styleClass="shell-user-name" text="User" />
                        <Label fx:id="roleLabel" styleClass="shell-user-meta" text="Role" />
                    </VBox>
                </HBox>
                <Button maxWidth="Infinity" onAction="#logout" styleClass="secondary-button" text="Logout" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0" styleClass="page-container">
            <padding>
                <Insets bottom="20.0" left="22.0" right="22.0" top="18.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="app-top-bar">
                <VBox spacing="4.0">
                    <Label fx:id="breadcrumbLabel" styleClass="muted-text" text="Home / Dashboard" />
                    <Label fx:id="currentPageLabel" styleClass="screen-title" text="Dashboard" />
                </VBox>

                <Region minHeight="50.0" prefHeight="50.0" HBox.hgrow="ALWAYS" />

                <TextField fx:id="globalSearchField" promptText="Search patients, appointments..." styleClass="global-search-field" />

                <Label fx:id="dateTimeLabel" styleClass="muted-text top-bar-datetime" text="--" />

                <MenuButton styleClass="quick-actions-button" text="+ Quick Actions">
                    <items>
                        <MenuItem onAction="#handleQuickCheckIn" text="Check-in Patient" />
                        <MenuItem onAction="#handleQuickAddPatient" text="Add Patient" />
                        <MenuItem onAction="#handleQuickEnterVitals" text="Enter Vitals" />
                        <MenuItem onAction="#handleQuickNewAppointment" text="New Appointment" />
                        <MenuItem onAction="#handleQuickAddPayment" text="Add Payment" />
                        <MenuItem onAction="#handleQuickSendMessage" text="Send Message" />
                    </items>
                </MenuButton>

                <Button fx:id="alertsIconButton" minHeight="35.0" onAction="#showNotifications" prefHeight="35.0" prefWidth="50.0" styleClass="top-icon-button notification-icon-button" text="🔔 0" />

                <Button fx:id="messagesIconButton" minHeight="35.0" onAction="#showMessages" prefHeight="35.0" prefWidth="50.0" styleClass="top-icon-button message-icon-button" text="💬 0" />

                <Button fx:id="themeToggleButton" minHeight="35.0" onAction="#toggleTheme" prefHeight="35.0" prefWidth="50.0" styleClass="top-icon-button theme-icon-button" text="☀" />

                <MenuButton fx:id="profileMenuButton" styleClass="profile-chip" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane styleClass="profile-avatar-circle">
                                <Label fx:id="profileChipAvatarLabel" styleClass="profile-avatar-text" text="S" />
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label fx:id="profileChipNameLabel" styleClass="profile-chip-name" text="User" />
                                <Label fx:id="profileChipRoleLabel" styleClass="profile-chip-meta" text="Role" />
                            </VBox>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem onAction="#showSettings" text="Profile / Settings" />
                        <MenuItem onAction="#showMessages" text="Messages" />
                        <MenuItem onAction="#logout" text="Logout" />
                    </items>
                </MenuButton>
            </HBox>

            <Label fx:id="contextNoticeLabel" managed="false" styleClass="status-info" text="Context notice" visible="false" wrapText="true" />

            <BorderPane fx:id="contentPane" styleClass="content-root" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
