<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="760.0"
        xmlns="http://javafx.com/javafx/17.0.15"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="app.AppLayoutController" styleClass="app-shell content-page">

    <left>
        <VBox
                prefWidth="286.0"
                spacing="18.0" styleClass="app-sidebar">

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-brand-block">
                <StackPane styleClass="shell-brand-logo">
                    <ImageView fx:id="sidebarLogoImage"
                               fitWidth="38"
                               fitHeight="38"
                               preserveRatio="true"
                               smooth="true" />
                </StackPane>

                <VBox spacing="2.0">
                    <Label text="SPMS" styleClass="shell-brand-title" />
                    <Label text="Smart Clinic Patient Monitoring System"
                           wrapText="true" styleClass="shell-brand-subtitle" />
                </VBox>
            </HBox>

            <VBox
                    spacing="4.0" styleClass="shell-user-block">

                <Label
                        fx:id="userLabel"
                        text="User" styleClass="shell-user-name" />

                <Label
                        fx:id="roleLabel"
                        text="Role | Section"
                        wrapText="true" styleClass="shell-user-meta" />
            </VBox>

            <VBox spacing="7.0" styleClass="shell-nav-list">

                <Button fx:id="dashboardButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button-blue-active" />

                <Button fx:id="patientsButton" text="Patients" onAction="#showPatients" maxWidth="Infinity" styleClass="transparent-pane nav-button-blue" />

                <Button fx:id="messagesButton" text="Messages" onAction="#showMessages" maxWidth="Infinity"
                        managed="false" visible="false" styleClass="transparent-pane nav-button-blue" />

                <Button fx:id="schedulingButton" text="Scheduling" onAction="#showScheduling" maxWidth="Infinity"
                        managed="false" visible="false" styleClass="transparent-pane nav-button-blue" />

                <Button fx:id="userDirectoryButton" text="Staff / Users" onAction="#showUserDirectory" maxWidth="Infinity"
                        managed="false" visible="false" styleClass="transparent-pane nav-button-blue" />

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="shell-status-card">
                <Label text="OK" styleClass="shell-status-icon" />
                <VBox spacing="2.0">
                    <Label text="System Status" styleClass="shell-status-title" />
                    <Label text="Online" styleClass="shell-status-text" />
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="content-page">
            <top>
                <HBox alignment="CENTER_RIGHT" spacing="14.0" styleClass="shell-top-bar">

                    <Label fx:id="topUserLabel" text="User | Section" styleClass="muted-text" />

                    <Label fx:id="roleBadgeLabel" text="UNKNOWN" styleClass="role-unknown" />

                    <Button fx:id="topNotificationButton" text="Alerts" onAction="#showNotifications" styleClass="shell-bell-button" />

                    <Label fx:id="unreadCountLabel" text="0" styleClass="notification-badge" />

                    <MenuButton fx:id="profileMenuButton" text="Profile" styleClass="shell-profile-menu">
                        <items>
                            <MenuItem text="Profile / Settings" onAction="#showSettings" />
                            <MenuItem text="Messages" onAction="#showMessages" />
                            <MenuItem text="Logout" onAction="#logout" />
                        </items>
                    </MenuButton>
                </HBox>
            </top>

            <center>
                <BorderPane fx:id="contentPane" styleClass="content-root" />
            </center>
        </BorderPane>
    </center>
</BorderPane>
